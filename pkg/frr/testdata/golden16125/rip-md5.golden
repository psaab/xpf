! xpf managed config - do not edit
!
ip prefix-list xpf-rip-0-grp-0 seq 5 deny 0.0.0.0/0 le 32
ipv6 prefix-list xpf-rip-0-grp-0-v6 seq 5 deny ::/0 le 128
!
router rip
 distance 100
 network ge-0-0-0
 network ge-0-0-1
 passive-interface ge-0-0-1
 redistribute connected
 redistribute static
 distribute-list prefix xpf-rip-0-grp-0 out ge-0-0-0
 distribute-list prefix xpf-rip-0-grp-0 out ge-0-0-1
exit
!
interface ge-0-0-0
 ip rip authentication mode md5
 ip rip authentication string rip-secret
exit
!
interface ge-0-0-1
 ip rip authentication mode md5
 ip rip authentication string rip-secret
exit
!
