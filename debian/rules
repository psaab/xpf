#!/usr/bin/make -f
# xpf Debian package rules (increment A of #1917).
#
# We deliberately do NOT use dh-golang or dh's auto Go/Cargo build:
# xpfd embeds the kernel-verified AF_XDP shim (#1864) and the helper
# is built with a pinned cargo via the project Makefile. Re-deriving
# the build inside dh would bypass that discipline. So the build step
# delegates to the project Makefile and the install step copies the
# freshly built binaries into the dpkg-static staging path.
#
# Layout (plan #1917 §6.1 / §6.3c):
#   /usr/local/share/xpf/staged/{xpfd,xpf-userspace-dp,cli,xpf-day0-config}
#       dpkg-static staging path. dpkg owns ONLY this path. It never
#       writes the live /usr/local/sbin symlinks or any runtime
#       versioned dir. The in-place cut-over mechanism (increment B)
#       owns /var/lib/xpf/versions/<v>/ and the atomic symlink flip.
#   The live /usr/local/sbin/{xpfd,cli,...} symlinks are created by
#   the maintainer scripts on FIRST install only (no running version
#   to protect). On upgrade dpkg only refreshes the staging path; the
#   live symlinks are left untouched so a plain apt upgrade never cuts
#   the dataplane (increment B drives the verified cut explicitly).
#   #1964: on first install the postinst SEEDS the versioned runtime
#   (xpfd seed-runtime) — copy staged/* -> versions/<v>/, current -> <v>,
#   sbin -> versions/current/<bin> — so a real rollback target exists from
#   the first boot. versions/ stays maintainer-script-managed (never in
#   dpkg's file list); dpkg still owns ONLY the staging path.

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

STAGED = /usr/local/share/xpf/staged

%:
	dh $@

# Build the binary set via the project Makefile so the embedded shim
# and pinned cargo build are used unchanged. CARGO_TARGET_DIR is left
# at the project default on purpose: the Makefile's build-userspace-dp
# installs from userspace-dp/target/release/, and overriding the target
# dir to a scratch path would install a stale binary.
#
# Stage the systemd units into debian/ under the package-canonical
# names so dh_installsystemd finds them. The unit sources remain in
# test/incus/ and scripts/image/ (the test env and bake consume the
# same files); the package re-homes them at /lib/systemd/system.
#
# The package-owned xpfd.service gets an ExecStartPre verify-dataplane
# gate injected (plan §6.2 / §7): the #1864/#1869 kernel-verifier gate
# must run at EVERY boot, not only once at bake time — a later kernel
# change or a skipped bake validation must never reach ExecStart with a
# verifier-failing shim. exit 3 = REJECT aborts the start. We inject it
# here (rather than editing test/incus/xpfd.service) so the gate ships in
# the appliance package without changing the dev/test unit source; the
# binary the gate runs is the live /usr/local/sbin/xpfd symlink.
override_dh_auto_build:
	$(MAKE) build build-ctl build-userspace-dp
	@# Match ExecStart tolerating leading whitespace and spaces around '='
	@# (systemd accepts those), then HARD-ASSERT the gate landed — a silent
	@# sed miss (e.g. if the unit source is reformatted) must FAIL the build,
	@# never ship a package-staged unit that skips the verifier (AGY r2).
	sed -E '/^[[:space:]]*ExecStart[[:space:]]*=/i ExecStartPre=/usr/local/sbin/xpfd verify-dataplane' \
	    test/incus/xpfd.service > debian/xpf.xpfd.service
	grep -q '^ExecStartPre=/usr/local/sbin/xpfd verify-dataplane$$' debian/xpf.xpfd.service || \
	    { echo "FATAL: ExecStartPre verify-dataplane injection failed (xpfd.service ExecStart line not matched)" >&2; exit 1; }
	cp scripts/image/xpf-day0-config.service debian/xpf.xpf-day0-config.service
	@# #9725: the boot-only oneshot that keeps kernel transit closed from boot
	@# until xpfd starts (xpfd's transit gate owns it from then on), whatever an
	@# older image's sysctl.d says.
	cp scripts/image/xpf-transit-closed.service debian/xpf.xpf-transit-closed.service
	@# #1930 LANE-1 kernel channel: stage the two oneshot units under the
	@# package-canonical names so dh_installsystemd enables them. These ship in
	@# the .deb (not only the bake) so foreign-host / manual installs get the
	@# full A4 substrate (r1 Codex: packaging must not miss the slot substrate +
	@# the promotion gate).
	cp scripts/image/xpf-uefi-slots.service debian/xpf.xpf-uefi-slots.service
	cp scripts/image/xpf-kernel-promote.service debian/xpf.xpf-kernel-promote.service
	@# #4202: the promote unit's OnFailure= recovery unit MUST ship in the .deb
	@# too. bake.py stages it into the image, but a deb-installed / foreign host
	@# had a DANGLING OnFailure= target ("Unit not found") — a hung promotion
	@# gate then left the node on the unverified candidate held SECONDARY with no
	@# recovery reboot. Stage it under the package-canonical name. It has no
	@# [Install] section (OnFailure=-triggered, never enabled) so it is installed
	@# without dh_installsystemd enable/start (see override_dh_installsystemd).
	cp scripts/image/xpf-kernel-promote-failed.service \
	    debian/xpf.xpf-kernel-promote-failed.service
	@# Parity assert: the OnFailure= target the promote unit references MUST be a
	@# unit we actually stage into the .deb, else the recovery reboot is a
	@# dangling reference on every deb-installed host. A future edit that drops
	@# the staging (or renames the target) must FAIL the build, not ship the gap.
	onfail=$$(sed -n 's/^OnFailure=//p' scripts/image/xpf-kernel-promote.service | head -n1); \
	    test -n "$$onfail" || { echo "FATAL: xpf-kernel-promote.service has no OnFailure= target" >&2; exit 1; }; \
	    test -f "debian/xpf.$$onfail" || { echo "FATAL: OnFailure= target $$onfail not staged in the .deb (dangling recovery unit)" >&2; exit 1; }

# Nothing to test in the package build itself; the project test suite
# is run separately. Skip dh's auto test (it would try `go test`).
override_dh_auto_test:

override_dh_auto_install:
	install -d debian/xpf$(STAGED)
	@# Managed-binary staging (#1982). The single source of truth for this
	@# set is the Go manifest pkg/upgrade/manifest; this install list is kept
	@# explicit (no generated make var sed'd into the tracked rules) so the
	@# build never mutates the checkout. The drift canary
	@# (TestManagedBinaryDriftCanary, pkg/upgrade/manifest) FAILS the suite if
	@# this set diverges from manifest.Names(). Add a managed binary here AND
	@# in the manifest.
	install -m 0755 xpfd              debian/xpf$(STAGED)/xpfd
	install -m 0755 cli               debian/xpf$(STAGED)/cli
	install -m 0755 xpf-userspace-dp  debian/xpf$(STAGED)/xpf-userspace-dp
	install -m 0755 scripts/image/xpf-day0-config \
	                                  debian/xpf$(STAGED)/xpf-day0-config
	install -d debian/xpf/etc/needrestart/conf.d
	install -m 0644 debian/xpf.needrestart \
	                debian/xpf/etc/needrestart/conf.d/xpf.conf
	@# Ship the apt archive keyring in the package payload (#1924 NIT-2) so
	@# existing hosts get a ROTATED key via `apt upgrade` even though they
	@# never re-run install.sh. Install under /usr/share/keyrings (NOT
	@# /etc): a file under /etc is a dpkg CONFFILE — install.sh writes the
	@# key before `apt install`, so dpkg would hit a conffile prompt (hangs
	@# unattended installs) and `force-confnew` would clobber the real key
	@# with the placeholder (fleet lockout). /usr/share/keyrings is
	@# package-owned and updates seamlessly on upgrade (AGY-A1). Prefer the
	@# real key when the release build has dropped it in; otherwise ship the
	@# placeholder (apt rejects the signature — the correct fail-safe).
	install -d debian/xpf/usr/share/keyrings
	if [ -f scripts/dist/xpf-archive-keyring.asc ]; then \
	    install -m 0644 scripts/dist/xpf-archive-keyring.asc \
	            debian/xpf/usr/share/keyrings/xpf-archive-keyring.asc; \
	else \
	    install -m 0644 scripts/dist/xpf-archive-keyring.asc.placeholder \
	            debian/xpf/usr/share/keyrings/xpf-archive-keyring.asc; \
	fi
	@# #1930 LANE-1 kernel channel: the slot-registration + promotion-gate
	@# scripts and the $cmdpath grub.d fragment ship in the .deb so a manual /
	@# foreign-host install gets the full A4 substrate (the bake also stages the
	@# A/B ESP slot dirs, which are image-specific).
	install -d debian/xpf/usr/local/sbin
	install -m 0755 scripts/image/xpf-uefi-slots \
	                debian/xpf/usr/local/sbin/xpf-uefi-slots
	install -m 0755 scripts/image/xpf-kernel-promote \
	                debian/xpf/usr/local/sbin/xpf-kernel-promote
	install -d debian/xpf/etc/grub.d
	install -m 0755 scripts/image/grub.d/09_xpf \
	                debian/xpf/etc/grub.d/09_xpf

# Disable the auto-restart-on-upgrade block dh_installsystemd would
# otherwise append to postinst. A plain `apt upgrade xpf` must NOT
# cycle xpfd (a full dataplane gap); the verified cut-over is driven
# explicitly by the increment-B mechanism. --no-stop-on-upgrade is the
# documented directive (--no-restart-on-upgrade is a deprecated alias).
# The units are still enabled on install via dh_installsystemd.
override_dh_installsystemd:
	dh_installsystemd --no-stop-on-upgrade --name=xpfd
	dh_installsystemd --no-stop-on-upgrade --name=xpf-day0-config
	@# #9725: enable the boot-only transit close. --no-start: starting it on a
	@# running firewall would close transit under an attached xpfd.
	dh_installsystemd --no-start --no-stop-on-upgrade --name=xpf-transit-closed
	@# #1930: enable the two LANE-1 oneshots. They are best-effort + non-fatal
	@# (degrade to "LANE 1 unavailable" on non-UEFI / read-only NVRAM) and are
	@# NOT ordered Before=xpfd, so enabling them cannot block the daemon.
	dh_installsystemd --no-stop-on-upgrade --name=xpf-uefi-slots
	dh_installsystemd --no-stop-on-upgrade --name=xpf-kernel-promote
	@# #4202: install the OnFailure= recovery unit into /lib/systemd/system but
	@# do NOT enable/start it — it has no [Install] section and is triggered only
	@# via the promote unit's OnFailure=. dh_installsystemd still installs the
	@# unit file; --no-enable/--no-start suppress the enable + start snippets.
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade \
	    --name=xpf-kernel-promote-failed

override_dh_clean:
	rm -f debian/xpf.xpfd.service debian/xpf.xpf-day0-config.service \
	      debian/xpf.xpf-transit-closed.service \
	      debian/xpf.xpf-uefi-slots.service debian/xpf.xpf-kernel-promote.service \
	      debian/xpf.xpf-kernel-promote-failed.service
	dh_clean

# xpf is an APPLIANCE package, not a Debian-archive package: it
# deliberately owns /usr/local (the staged binary set under
# /usr/local/share/xpf/staged and the live /usr/local/sbin symlinks the
# maintainer scripts manage) because the appliance image, the systemd
# units, and the in-place upgrade mechanism all key off /usr/local/sbin.
# dh_usrlocal enforces the Debian Policy rule that archive packages must
# not ship FILES under /usr/local; we accept that deviation here and
# skip it. Removal of the /usr/local dirs/symlinks is handled by our own
# postrm (symlinks) and is otherwise harmless (shared, admin-owned tree).
override_dh_usrlocal:

# The staged binaries are stripped by the upstream build already where
# applicable; do not let dh strip / instrument them further (the Go
# binaries are static and the Rust binary carries its own settings).
override_dh_strip:

override_dh_dwz:
