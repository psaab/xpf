#!/bin/sh
# xpf postrm (increment A of #1917; #1964 versioned-runtime lifecycle).
#
# Remove the live /usr/local/sbin symlinks this package created — both the
# legacy direct-to-staged links AND the #1964 links that resolve through
# /var/lib/xpf/versions/current. State under /etc/xpf (.configdb, node-id,
# master.key) is runtime state and is NEVER touched here, not even on purge.
#
# versions/ is package-derived runtime state (copied binaries), NOT operator
# config — so it is LEFT on `remove` (a reinstall reuses it) and REMOVED on
# `purge` (Debian Policy §6.8). Unlike /etc/xpf, removing versions/ on purge
# is correct: it is copied binaries, not user data.
#
# DOWNGRADE (`postrm upgrade <new-version>` to a package that PREDATES the
# #1964 hardened layout): the pre-#1964 package points sbin directly at
# staged/ and does not manage versions/, so a lingering hardened drop-in +
# versions/current would keep the unit running the NEWER binaries (the
# drop-in ExecStart pins the concrete newer version dir) — a silent version
# mismatch. This postrm detects that case and cleans up: repoint sbin back to
# staged atomically, remove the runtime drop-in (with a boot-guarded
# daemon-reload), and DELETE versions/current LAST. The destructive current
# delete runs after the drop-in removal (#1997) so a kill mid-teardown never
# leaves an orphan drop-in that a postrm RERUN would skip; the rerun guard
# also keys on the drop-in's presence so a rerun re-enters and converges.
#
# #1985: detection keys on the dpkg-supplied INCOMING version ($2), NOT on an
# exec of the staged binary. The original code probed
# `"$STAGED/xpfd" seed-runtime --capability-check` and treated ANY non-zero
# exit as "pre-#1964, tear the layout down". The `&&` short-circuited to false
# whenever the staged xpfd could not EXEC at all (dynamic-link error during
# unpack, corruption, libc/ABI conflict, arch mismatch) — not only when it
# genuinely lacked the subcommand. That conflated "new binary lacks the
# layout" with "new binary cannot run", so a non-execable staged xpfd on a
# real UPGRADE ran the destructive teardown and broke the daemon on next boot.
#
# The sound, exec-free signal is the version: dpkg passes $2 = the version
# being installed. A genuine pre-#1964 downgrade has $2 < the layout floor;
# an upgrade or a hardened->hardened downgrade has $2 >= the floor. We compare
# with `dpkg --compare-versions` (always present in a maintainer script).
# A presence-only file marker was rejected: dpkg removes a file that exists
# ONLY in the old package AFTER old-postrm runs (Debian Policy 6.6 unpack
# order), so a marker shipped by the hardened package LINGERS on disk at
# old-postrm time during a genuine pre-#1964 downgrade and would mis-signal
# "incoming is hardened" — skipping the teardown that the downgrade needs.
# The version arg has no such staleness.
#
# Safe-fallback posture (mirrors the sibling preinst migrate_legacy_layout):
# if $2 is empty or unparsable we LEAVE the hardened layout intact rather than
# destroy it — the verify-dataplane cut gate / refuse-before-STOP guard is
# the backstop. We tear down ONLY when $2 is a confirmed pre-#1964 version.
#
# REMOVE/PURGE drop-in cleanup (#1967): on remove/purge the runtime unit
# drop-in /etc/systemd/system/xpfd.service.d/10-xpf-version.conf (written by
# writeUnitDropin, flip.go) must be removed too — otherwise systemd keeps a
# unit drop-in whose ExecStart pins a now-deleted versions/<ver>/xpfd path,
# leaving a broken unit referencing a removed binary. We also rmdir the
# (now-empty) .service.d dir and boot-guard a daemon-reload so systemd drops
# the removed drop-in. (The downgrade path below already does this for its
# own correctness; #1967 extends it to remove/purge.)

set -e

STAGED=/usr/local/share/xpf/staged
SBIN=/usr/local/sbin
VERSIONS=/var/lib/xpf/versions
CURRENT="$VERSIONS/current"
# #1981 Option B staged-generation root: maintainer-script-managed runtime
# state (a sibling of versions/), NEVER a dpkg payload file — so dpkg never
# removes it. We must remove it on purge (else an orphan dir survives, a Policy
# violation) and on a pre-B downgrade (the old postrm never learns about it).
STAGED_GEN=/var/lib/xpf/staged-gen
DROPIN=/etc/systemd/system/xpfd.service.d/10-xpf-version.conf
# #10758 legacy Requires-link cleanup. The pre-fix fence unit used
# RequiredBy=systemd-networkd.service, creating this link under /etc/systemd.
# Its Requires edge propagated the generated prerm stop to networkd, and a
# remove without purge left the link dangling. xpf.prerm removes it before the
# generated stop hook; this postrm cleanup is an idempotent fallback for older
# script flows. Only a symlink is ours.
TRANSIT_CLOSED_REQUIRES_LINK=/etc/systemd/system/systemd-networkd.service.requires/xpf-transit-closed.service
# apt source that the Tailscale-style install.sh writes (#1924, H-16). It is
# NOT a dpkg payload file (install.sh writes it, not the package), so dpkg
# never removes it — but its Signed-By keyring IS package payload
# (/usr/share/keyrings, debian/rules). On `apt remove` dpkg deletes the keyring
# and would leave this source pointing at a now-missing keyring, breaking every
# later `apt update`. We purge it here, but ONLY if WE wrote it (its marker
# comment is present) so an operator-authored source is never touched.
XPF_APT_SRC=/etc/apt/sources.list.d/xpf.sources
XPF_APT_SRC_MARKER="Managed by install.sh"
# #1985 hardened-layout version floor. This is the first package whose postrm
# manages the #1964 versioned-runtime layout (versions/current + the unit
# drop-in) on downgrade and whose xpfd answers `seed-runtime
# --capability-check` — i.e. the first package that can be classified as
# hardened by this teardown contract. That commit is `ef9525e70` ("#1964:
# postrm versioned-link cleanup, purge tree removal, downgrade"), whose `git
# rev-list --count` is 4104. (Earlier #1964 commits added the postinst seed at
# 4102 and the preinst migration at 4103, but the postrm downgrade handling
# this floor protects landed at 4104.) The .deb version scheme is
# `0.0.<commit-count>+g<sha>` (Makefile DEB_VERSION), monotonic in commit
# count, so any incoming package with version < 0.0.4104 PREDATES the contract
# and is a genuine pre-#1964 downgrade; >= 0.0.4104 (incl. the floor version
# 0.0.4104+g<sha>, which sorts ABOVE the bare 0.0.4104 floor since `+...`
# sorts after the empty string) is hardened. This is a HISTORICAL fixed point
# (the contract already shipped), not a value that drifts per build — do
# not bump it with new releases.
HARDENED_LAYOUT_FLOOR="0.0.4104"
# #1981 staged-generation floor. staged-gen/ (immutable versioned staging) is
# written ONLY by a #1981+ package; a pre-#1981 package — whether pre- OR
# post-#1964 — never manages it, so on a downgrade BELOW this floor we must
# remove staged-gen/ (else it leaks permanently: the downgraded postrm never
# learns about it). This is a SEPARATE, HIGHER floor than the #1964 layout
# floor above, so a post-#1964-but-pre-#1981 downgrade still tears staged-gen/
# down even though it leaves the #1964 versioned-runtime layout intact. The
# value is a conservative LOWER BOUND: the last pre-#1981 master commit count
# was 4199, so 0.0.4200 classifies every pre-#1981 build (<= 4199) as below the
# floor while the first #1981 package (commit count well above 4200) sorts at
# or above it. HISTORICAL fixed point — do not bump per build.
STAGED_GEN_FLOOR="0.0.4200"
# Managed-binary set (#1982). The single source of truth is the Go manifest
# pkg/upgrade/manifest; this literal is kept self-contained on purpose (no
# build-time sed into the tracked checkout). The drift canary
# (TestManagedBinaryDriftCanary, pkg/upgrade/manifest) FAILS the suite if this
# list diverges from manifest.Names(). Edit both together.
BINS="xpfd cli xpf-userspace-dp xpf-day0-config"
# Transit sysctls are closed by xpfd on orderly shutdown and outlive it.
TRANSIT_IPV4_SYSCTL=/proc/sys/net/ipv4/ip_forward
TRANSIT_IPV6_SYSCTL=/proc/sys/net/ipv6/conf/all/forwarding

cleanup_transit_state() {
    # Keep the removal command before unlinking /usr/local/sbin/xpfd: the
    # versioned runtime remains available until the purge tree cleanup below.
    # Only invoke a package-owned link; an operator-repointed xpfd is not ours.
    # If the runtime is unavailable or cannot remove the barrier, leave the
    # sysctls untouched rather than opening forwarding behind a stale fence.
    if ! link_is_owned "$SBIN/xpfd" || [ ! -x "$SBIN/xpfd" ]; then
        echo "xpf: cannot remove the transit barrier; package xpfd is unavailable" >&2
        return 0
    fi
    if ! "$SBIN/xpfd" transit-barrier remove; then
        echo "xpf: transit barrier removal failed; leaving forwarding sysctls unchanged" >&2
        return 0
    fi
    # Restore the normal forwarding posture after deleting the xpf fence.
    # These are best-effort procfs writes; a non-booted package-build/chroot
    # has no live sysctls and must not fail package removal.
    for path in "$TRANSIT_IPV4_SYSCTL" "$TRANSIT_IPV6_SYSCTL"; do
        if [ -e "$path" ]; then
            printf '1\n' > "$path" 2>/dev/null || \
                echo "xpf: could not restore forwarding sysctl $path" >&2
        fi
    done
}


# atomic_symlink LINK TARGET — point LINK at TARGET via temp symlink +
# rename (atomic; no unlink-then-create window).
atomic_symlink() {
    _link="$1"; _target="$2"
    mkdir -p "$(dirname "$_link")"
    # Clear any stale temp path first (Copilot): a leftover directory at
    # "$_link.tmp" would make `ln -sf` nest the symlink inside it and the
    # `mv -f` act on the wrong path.
    rm -rf "$_link.tmp"
    ln -sf "$_target" "$_link.tmp"
    mv -f "$_link.tmp" "$_link"
}

# link_is_owned reports (exit 0) whether $1 is a symlink WE own — its target
# is under the staging path (legacy) OR versions/current (#1964). A link an
# operator repointed elsewhere is NOT owned and must never be touched.
link_is_owned() {
    [ -L "$1" ] || return 1
    _t=$(readlink "$1" 2>/dev/null || true)
    case "$_t" in
        "$STAGED"/*|"$CURRENT"/*) return 0 ;;
        *) return 1 ;;
    esac
}

# remove_owned_sbin_links removes each sbin link we own.
remove_owned_sbin_links() {
    for b in $BINS; do
        link="$SBIN/$b"
        if link_is_owned "$link"; then
            rm -f "$link"
        fi
    done
}

# remove_install_sh_apt_source removes the apt source that install.sh wrote,
# but ONLY when it carries our marker comment (a "we wrote it" check mirroring
# link_is_owned) — an operator-authored xpf.sources is left untouched (#1924,
# H-16). Without this, `apt remove xpf` deletes the package-payload keyring and
# strands this source, breaking `apt update` until a hand-delete. Best-effort /
# idempotent (safe if absent).
remove_install_sh_apt_source() {
    [ -f "$XPF_APT_SRC" ] || return 0
    if grep -qF "$XPF_APT_SRC_MARKER" "$XPF_APT_SRC" 2>/dev/null; then
        echo "xpf: removing install.sh-written $XPF_APT_SRC so the removed" \
             "keyring does not strand apt update." >&2
        rm -f "$XPF_APT_SRC"
    fi
}

# remove_runtime_dropin removes the #1964 versioned-runtime unit drop-in and
# the now-empty .service.d dir, then boot-guarded daemon-reloads so systemd
# drops the removed drop-in. Shared by the remove/purge and downgrade paths
# (#1967). All steps are best-effort / idempotent (safe if absent).
remove_runtime_dropin() {
    rm -f "$DROPIN"
    # rmdir the .d dir if it is now empty (best-effort — leave it if other
    # drop-ins live there).
    rmdir "$(dirname "$DROPIN")" 2>/dev/null || true
    # Boot-guard the daemon-reload: in a non-booted env (docker/chroot/bake)
    # systemctl exits non-zero and, under set -e, would fail the maintainer
    # script — guard on /run/systemd/system.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload 2>/dev/null || true
    fi
}

# remove_legacy_transit_requires_link scrubs the pre-#10758 networkd Requires
# link if an older script flow reaches postrm without the new prerm having
# removed it before the generated stop hook. Only the symlink created by systemd
# enablement is ours; leave a regular operator file and foreign entries alone.
remove_legacy_transit_requires_link() {
    [ -L "$TRANSIT_CLOSED_REQUIRES_LINK" ] || return 0
    echo "xpf: removing legacy systemd-networkd .requires link for xpf-transit-closed (#10758)" >&2
    rm -f "$TRANSIT_CLOSED_REQUIRES_LINK"
    rmdir "$(dirname "$TRANSIT_CLOSED_REQUIRES_LINK")" 2>/dev/null || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload 2>/dev/null || true
    fi
}

# repoint_owned_sbin_to_staged points each OWNED sbin link back at staged/
# (atomic). It SKIPS a foreign/operator-repointed link (Codex) — a downgrade
# must not clobber an operator's custom target.
repoint_owned_sbin_to_staged() {
    for b in $BINS; do
        link="$SBIN/$b"
        if link_is_owned "$link"; then
            atomic_symlink "$link" "$STAGED/$b"
        else
            echo "xpf: leaving non-package sbin link $link untouched on downgrade" >&2
        fi
    done
}

# incoming_predates_hardened_layout VERSION reports (exit 0) whether the
# INCOMING package version VERSION ($2 on `postrm upgrade`) predates the #1964
# hardened layout floor — i.e. this is a genuine pre-#1964 downgrade that
# must tear the hardened artifacts down. It is EXEC-FREE (the #1985 fix: never
# run the staged binary) and staleness-free (uses the dpkg version, not an
# on-disk file). Empty or unparsable VERSION returns NON-zero (false) so the
# caller takes the SAFE branch (leave the layout intact) rather than destroy
# it on ambiguity — mirroring the preinst migrate_legacy_layout posture.
incoming_predates_hardened_layout() {
    _v="$1"
    [ -n "$_v" ] || return 1
    # `dpkg --compare-versions` returns 0 (true: _v lt floor), 1 (not-less),
    # or 2 (UNPARSABLE version). Only a clean 0 counts as a confirmed
    # pre-#1964 downgrade; map anything else to return 1 (keep). The explicit
    # `|| return 1` also keeps this helper safe under `set -e` if it is ever
    # called outside an `if`/`&&` condition in a future edit (AGY).
    dpkg --compare-versions "$_v" lt "$HARDENED_LAYOUT_FLOOR" 2>/dev/null || return 1
}

# incoming_predates_staged_gen VERSION reports (exit 0) whether the INCOMING
# package version predates the #1981 staged-generation floor — a downgrade to a
# package that does not manage staged-gen/, so we must remove it (else it leaks
# permanently). Same exec-free, staleness-free, safe-on-ambiguity posture as
# incoming_predates_hardened_layout, against the higher STAGED_GEN_FLOOR.
incoming_predates_staged_gen() {
    _v="$1"
    [ -n "$_v" ] || return 1
    dpkg --compare-versions "$_v" lt "$STAGED_GEN_FLOOR" 2>/dev/null || return 1
}

case "$1" in
    remove|purge)
        cleanup_transit_state
        remove_owned_sbin_links
        # Remove the versioned-runtime unit drop-in too (#1967): an orphaned
        # drop-in pins ExecStart to a deleted versions/<ver>/xpfd path and
        # leaves a broken unit. Safe if absent (legacy/never-seeded hosts).
        remove_runtime_dropin
        # Clear the pre-#10758 networkd Requires link too. xpf.prerm normally
        # removes it before the generated stop hook; this is an idempotent
        # postrm fallback so remove-without-purge cannot leave it dangling.
        remove_legacy_transit_requires_link
        # Purge the install.sh-written apt source (#1924, H-16): the keyring it
        # references is package payload dpkg is deleting now, so leaving the
        # source would break `apt update`. Marker-gated so operator sources are
        # untouched.
        remove_install_sh_apt_source
        if [ "$1" = "purge" ]; then
            # versions/ and staged-gen/ are package-derived (copied binaries),
            # not operator config — remove the whole trees on purge. staged-gen/
            # (#1981) is a never-recorded runtime dir, so dpkg's own cleanup
            # never touches it; an orphan would survive purge (Policy 6.8).
            rm -rf "$VERSIONS"
            rm -rf "$STAGED_GEN"
        fi
        ;;
    upgrade)
        # $2 is the version being installed. On a DOWNGRADE to a package that
        # predates the #1964 hardened layout, tear our hardened artifacts
        # down so the downgraded package's direct-staged links take effect.
        #
        # Detection is the EXEC-FREE incoming-version compare (#1985): tear
        # down ONLY when $2 is a confirmed pre-#1964 version (below the layout
        # floor) AND a hardened artifact is present. An upgrade or a
        # hardened->hardened downgrade ($2 >= floor) — and an empty/unparsable
        # $2 — leave the layout intact. Never exec the staged binary (the old
        # probe tore the layout down on ANY exec failure of a
        # hardened-but-unrunnable binary, #1985).
        #
        # The presence guard fires when EITHER versions/current OR the runtime
        # drop-in is still on disk (#1997). The drop-in arm is the crash-rerun
        # fix: the teardown is three idempotent steps, and an earlier release
        # gated the WHOLE block on versions/current alone while deleting
        # current BEFORE removing the drop-in. A kill in that window (current
        # already gone, drop-in still present) left an orphan
        # 10-xpf-version.conf pinning an ExecStart for a layout the downgraded
        # package no longer manages — and a postrm RERUN saw current gone, took
        # the false branch, and never cleaned the orphan up. Keying the guard
        # on the drop-in too lets a rerun re-enter and converge. We also remove
        # the drop-in BEFORE deleting current so the destructive `rm` is the
        # LAST step, shrinking the single-run orphan window to nothing for the
        # common case (the guard still covers the residual rerun case).
        #
        # Each artifact is probed with BOTH -L and -e (Copilot): a bare -e is
        # FALSE for a dangling symlink, so a drop-in (or current) that is a
        # broken symlink would otherwise slip past the guard and skip the
        # cleanup. -L catches the symlink-exists case; -e catches a regular
        # file / resolvable link — together they mean "the artifact is present
        # in any form" and the teardown's rm -f handles either.
        if incoming_predates_hardened_layout "$2" && \
           { [ -L "$CURRENT" ] || [ -e "$CURRENT" ] || \
             [ -L "$DROPIN" ] || [ -e "$DROPIN" ]; }; then
            echo "xpf: #1964 downgrade to a pre-hardened package — removing the" \
                 "versioned-runtime drop-in and repointing sbin back to staged." >&2
            # 1. repoint OWNED sbin links back to staged (atomic) so the
            #    daemon resolves the downgraded binaries — skipping any
            #    foreign/operator-repointed link (Codex). Idempotent: a rerun
            #    that already repointed (or that finds current gone but a link
            #    still naming the removed current/<bin>, which link_is_owned
            #    still matches by target string) re-points to the same staged
            #    target.
            repoint_owned_sbin_to_staged
            # 2. remove the runtime unit drop-in + empty .service.d dir, then
            #    boot-guarded daemon-reload (shared helper, #1967). Done BEFORE
            #    the current delete (#1997) so the only step that can flip the
            #    presence guard false runs LAST — a kill before this point
            #    leaves current present and a rerun re-enters via either arm.
            remove_runtime_dropin
            # 3. delete versions/current — else a later re-upgrade sees
            #    current present, skips the legacy-migration snapshot, and
            #    repoints sbin to a stale version dir (AGY-r4-1). Leave the
            #    versions/<ver> dirs (harmless; a reinstall's GC reaps them).
            #    This is the last destructive step: after it the drop-in is
            #    already gone, so no orphan can outlive a completed run.
            rm -f "$CURRENT"
        fi
        # #1981 staged-generation teardown (B-P6) — a SEPARATE, HIGHER floor
        # than the #1964 layout teardown above (Codex r5-#5): staged-gen/ is
        # written only by a #1981+ package, so on a downgrade to ANY pre-#1981
        # package — including a post-#1964-but-pre-#1981 one that keeps the
        # versioned-runtime layout intact above — we remove staged-gen/ (else
        # the downgraded postrm never learns about it and it leaks
        # permanently). The pre-B cut reads live staged/ (its only source), so
        # removing staged-gen/ strips nothing the downgraded package uses.
        if incoming_predates_staged_gen "$2"; then
            rm -rf "$STAGED_GEN"
        fi
        ;;
    failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
