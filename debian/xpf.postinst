#!/bin/sh
# xpf postinst (#1917 — increment A packaging + increment B cut-over hook;
# #1964 — first-install versioned-runtime seed).
#
# dpkg installs the binary set to the dpkg-static staging path
# /usr/local/share/xpf/staged/. The running daemon resolves its
# binaries via /usr/local/sbin/* which are SYMLINKS that, after #1964,
# point THROUGH /var/lib/xpf/versions/current. On FIRST install (no
# previously configured version) we SEED the versioned runtime layout
# (`xpfd seed-runtime`): copy staged/* into versions/<v>/, set
# versions/current -> <v>, and repoint /usr/local/sbin/* through
# versions/current — so xpfd runs AND there is a real, immutable rollback
# target before the first in-place upgrade can ever STOP the daemon.
# versions/ is maintainer-script-managed runtime state, NEVER in dpkg's
# file list, so dpkg never clobbers a versioned rollback target (dpkg only
# ever writes staged/). On UPGRADE we leave the live symlinks untouched and
# hand the verified cut-over to the increment-B mechanism (`xpfd upgrade`):
#
#  - STANDALONE node: the postinst invokes `xpfd upgrade` — the
#    verified, atomic, rollback-capable STOP->FLIP->START cut to the
#    staged version (the increment-A window is now closed: the cut
#    copies staging into a versioned runtime dir, runs the kernel
#    verify gate, flips atomically, and pins the unit ExecStart to the
#    concrete version so a respawn never resolves a mismatched helper).
#  - CLUSTERED node (/etc/xpf/node-id present): STAGE-ONLY. The postinst
#    does NOT cut — a clustered node is cut ONLY by `xpfd upgrade
#    --rolling`, which sequences a controlled per-node drain so the
#    cluster keeps forwarding. Keyed on node-id ALONE so a degraded-HA
#    node never falls through to an uncoordinated standalone cut.

set -e

STAGED=/usr/local/share/xpf/staged
SBIN=/usr/local/sbin
# Managed-binary set (#1982). The single source of truth is the Go manifest
# pkg/upgrade/manifest; this literal is kept self-contained on purpose (no
# build-time sed into the tracked checkout). The drift canary
# (TestManagedBinaryDriftCanary, pkg/upgrade/manifest) FAILS the suite if this
# list diverges from manifest.Names(). Edit both together.
BINS="xpfd cli xpf-userspace-dp xpf-day0-config"

XPF_RUN_DIR=/run/xpf

XPF_VERSIONS_DIR=/var/lib/xpf/versions
XPF_UPGRADE_STATUS=/var/lib/xpf/upgrade-deferred
XPF_UPGRADE_STATUS_UNREADABLE=/var/lib/dpkg/info/xpf.upgrade-deferred-unreadable
XPF_PROC_DIR=/proc

# Record a publish/cut failure outside /run (which is tmpfs) so a successful
# postinst that deliberately leaves the old generation running remains
# machine-readable after reboot. Use the live daemon's executable when
# systemd can identify it; otherwise store "unknown" instead of guessing from
# versions/current.
record_upgrade_failure() {
    failure_reason=$1
    recovery_command=$2
    staged_version=unknown
    version_output=$("$STAGED/xpfd" version 2>/dev/null || true)
    staged_version=$(printf '%s\n' "$version_output" |
        sed -n 's/^xpfd \([^[:space:]]*\).*/\1/p')
    [ -n "$staged_version" ] || staged_version=unknown

    running_bin=
    if [ -d /run/systemd/system ]; then
        running_pid=$(systemctl show --property=MainPID --value xpfd.service 2>/dev/null || true)
        case "$running_pid" in
            ''|0|*[!0-9]*) ;;
            *)
                live_bin=$(readlink "$XPF_PROC_DIR/$running_pid/exe" 2>/dev/null || true)
                case "$live_bin" in
                    "$XPF_VERSIONS_DIR"/*/xpfd) running_bin=$live_bin ;;
                esac
                ;;
        esac
    fi
    running_version=unknown
    if [ -x "$running_bin" ]; then
        version_output=$("$running_bin" version 2>/dev/null || true)
        running_version=$(printf '%s\n' "$version_output" |
            sed -n 's/^xpfd \([^[:space:]]*\).*/\1/p')
        [ -n "$running_version" ] || running_version=unknown
    fi

    # A same-version reinstall cannot produce a staged-vs-running skew. Avoid
    # leaving an unresolvable cut-failed record for a generation replacement
    # that the live-version guard correctly refused.
    if [ "$failure_reason" = cut-failed ] &&
       [ "$staged_version" != unknown ] &&
       [ "$staged_version" = "$running_version" ]; then
        echo "xpf: staged and running versions are both $staged_version; no unresolved binary upgrade status" >&2
        clear_upgrade_failure
        return 0
    fi

    recorded_at=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo 1970-01-01T00:00:00Z)
    marker_tmp="$XPF_UPGRADE_STATUS.$$"
    status_dir=$(dirname "$XPF_UPGRADE_STATUS")
    status_name=$(basename "$XPF_UPGRADE_STATUS")
    # A killed writer can leave a complete-or-partial pid temp before rename.
    # Keep recent files (another writer may own one); sweep only after a 24h TTL.
    find "$status_dir" -maxdepth 1 -type f -name "$status_name.*" \
        -mmin +1440 -delete 2>/dev/null || true
    if ! mkdir -p "$status_dir" 2>/dev/null; then
        if ! write_upgrade_status_unreadable_marker; then
            return 1
        fi
        echo "xpf: WARNING could not create durable upgrade-status directory" >&2
        return 0
    fi
    if ! (umask 077
        {
            printf 'format=1\n'
            printf 'staged_version=%s\n' "$staged_version"
            printf 'running_version=%s\n' "$running_version"
            printf 'reason=%s\n' "$failure_reason"
            printf 'recovery=%s\n' "$recovery_command"
            printf 'recorded_at=%s\n' "$recorded_at"
        } > "$marker_tmp" &&
        sync -f "$marker_tmp" 2>/dev/null); then
        rm -f "$marker_tmp" 2>/dev/null || true
        if ! write_upgrade_status_unreadable_marker; then
            return 1
        fi
        echo "xpf: WARNING could not write and sync staged-vs-running upgrade status" >&2
        return 0
    fi
    if ! mv -f "$marker_tmp" "$XPF_UPGRADE_STATUS"; then
        rm -f "$marker_tmp" 2>/dev/null || true
        if ! write_upgrade_status_unreadable_marker; then
            return 1
        fi
        echo "xpf: WARNING could not install staged-vs-running upgrade status" >&2
        return 0
    fi
    if ! sync -f "$status_dir" 2>/dev/null; then
        echo "xpf: WARNING upgrade status is present but directory sync failed; durability across a crash is uncertain" >&2
        return 0
    fi
    if rm -f "$XPF_UPGRADE_STATUS_UNREADABLE" 2>/dev/null; then
        sync -f "$(dirname "$XPF_UPGRADE_STATUS_UNREADABLE")" 2>/dev/null || \
            echo "xpf: WARNING could not sync removal of unreadable-status marker" >&2
    fi
}

write_upgrade_status_unreadable_marker() {
    status_marker_dir=$(dirname "$XPF_UPGRADE_STATUS_UNREADABLE")
    if ! mkdir -p "$status_marker_dir" 2>/dev/null; then
        echo "xpf: WARNING could not create durable unreadable-status marker directory" >&2
        return 1
    fi
    if ! (umask 077
        printf 'status=unreadable\n' > "$XPF_UPGRADE_STATUS_UNREADABLE" &&
        sync -f "$XPF_UPGRADE_STATUS_UNREADABLE" 2>/dev/null); then
        echo "xpf: WARNING could not write durable unreadable-status marker" >&2
        return 1
    fi
    if ! sync -f "$status_marker_dir" 2>/dev/null; then
        echo "xpf: WARNING could not sync durable unreadable-status marker directory" >&2
        return 1
    fi
}

clear_upgrade_failure() {
    if rm -f "$XPF_UPGRADE_STATUS" "$XPF_UPGRADE_STATUS_UNREADABLE" 2>/dev/null; then
        sync -f "$(dirname "$XPF_UPGRADE_STATUS")" 2>/dev/null || true
        sync -f "$(dirname "$XPF_UPGRADE_STATUS_UNREADABLE")" 2>/dev/null || true
    else
        echo "xpf: WARNING could not clear resolved upgrade status" >&2
    fi
}

case "$1" in
    configure)
        # $2 is the previously-configured version, empty on first install.
        if [ -z "$2" ]; then
            # === #1964 first-install seed (mechanism A) ===
            #
            # Seed the versioned runtime layout BEFORE the debhelper-
            # generated section (see the token near the end of this file) starts
            # the unit: copy staged/* -> versions/<v>/, set versions/current
            # -> <v>, and repoint /usr/local/sbin/* THROUGH versions/current.
            # This gives the appliance a real, immutable rollback target so
            # the first in-place upgrade has a restorable PreviousVersion
            # instead of a hard-refusing first cut. No cut/verify/stop here.
            #
            # The seed lives in the Go binary (durable copy + atomic symlink
            # logic, unit-tested); the postinst runs AFTER unpack so the new
            # xpfd is on disk and runnable. It is idempotent — apt re-running
            # the postinst converges to the same state. If seeding fails we
            # FALL BACK to legacy direct-to-staged links so the daemon still
            # launches (degraded: the next upgrade then takes the legacy-
            # migration preinst path), and we do NOT fail the install (a
            # non-zero postinst leaves dpkg half-configured).
            # Establish a launchable path BEFORE handing control to seed-runtime.
            # If dpkg kills this shell while the child is copying or repointing
            # links, #DEBHELPER# may never run and the next boot still needs the
            # staged binaries to exist at their stable sbin names.
            mkdir -p "$SBIN"
            for b in $BINS; do
                ln -sfnT "$STAGED/$b" "$SBIN/$b"
            done

            if "$STAGED/xpfd" seed-runtime; then
                :
            else
                echo "xpf: WARNING seed-runtime failed; falling back to" \
                     "direct-staged sbin links (next upgrade will migrate)" >&2
                mkdir -p "$SBIN"
                for b in $BINS; do
                    # ln -sfnT replaces a pre-existing symlink atomically and
                    # FAILS (under set -e) rather than nesting a symlink
                    # INSIDE a real directory at the link path.
                    ln -sfnT "$STAGED/$b" "$SBIN/$b"
                done
            fi
            # === #10751 fresh-install barrier (fail-closed until first apply) ===
            #
            # dh_installsystemd --no-start stages xpf-input-closed.service for the
            # next boot but never starts it live. On a fresh install with the
            # network already up and no daemon enforcing, host listeners would
            # stay unenforced until reboot. Close that window now when booted
            # under systemd and nothing owns enforcement. Enforcement ownership
            # is probed cheapest-correct-first: a handoff marker from any xpfd
            # process (covers raw-binary daemons invisible to systemctl), then
            # a live barrier table (kernel truth, idempotent). Either hit skips
            # injection. A live xpfd with NEITHER is pre-handoff or flushed:
            # inject anyway — its next apply hands the table off — because an
            # is-active-first order would consult no kernel truth at all on a
            # live-but-pre-handoff daemon (round-4 finding R4-6). If that
            # daemon is actually armed with a failed marker write, `enable
            # --now` still injects nothing: ensure re-checks kernel truth
            # (live enforcement or a standing barrier) and no-ops. Only a
            # fully unguarded corner installs — and the daemon's next apply
            # hands it off. Upgrades never reach this branch. Never fail
            # the install.
            # Residual race (accepted): a concurrent first handoff between our
            # probes and `enable --now` still takes an injection it immediately
            # hands off; the window is milliseconds and the first apply
            # converges by removing the table.
            if [ -d /run/systemd/system ] && [ -x "$SBIN/xpfd" ]; then # 10751-BARRIER-GATE
                # NOTE: this probe is enforcing-aware, not presence-based: a
                # present-but-open shell (table exists, no DROP verdict —
                # flushed, or an admits-only generation) must INJECT, not
                # skip. Word-matching "drop" is sound for this fixed table
                # (no chain/counter/set name contains it; every enforcing
                # barrier variant carries a DROP verdict), and a missing
                # table (nft errors, no output) injects too.
                # M2 liveness: a merely present marker may be a dead
                # daemon's file surviving best-effort cleanup (or planted).
                # flock succeeds iff NO live process holds it (stale — do
                # not skip on it); it fails iff the owner lives (skip —
                # covers raw binaries invisible to systemctl). No flock(1)
                # means liveness is unprovable: treat as stale and fall
                # through to kernel truth (fail-closed; the R4-6 corner
                # self-heals). Residual (bounded, Opus10 M2 / Opus11 M2 —
                # every nonzero flock result reads live here, unlike the
                # daemon's error discrimination; reachable modes on /run
                # (tmpfs), each evidenced, exit table verified on tmpfs:
                # free 0, EX-held 1, SH-held 1, missing-path 0):
                # EX contention → live → skip: CORRECT, the live-owner case
                # (harness-pinned under sh+dash).
                # SH-only contention → live → skip: MISREAD, negligible —
                # no production SH holder exists (the sole LOCK_SH is the
                # daemon's transient discriminator probe), and 0600
                # root-only markers mean a persistent SH holder implies
                # root, out of model.
                # Missing FILE with present parent (the file-only -e/flock
                # TOCTOU) → exit 0 → stale → proceed: SAFE — and the probe
                # runs under umask 077, so a TOCTOU-recreated file lands
                # 0600 (not umask-derived 0664): the SH-negligible premise
                # holds for it too (mode asserted by fixture).
                # Missing PARENT → flock exits 66 → live → skip: bounded —
                # creation ensures the dir (daemon MkdirAll 0755), removal
                # unlinks file-only (daemon clear, postrm rm -f), and dpkg
                # serializes postrm vs postinst, so only a manual rm -rf in
                # the microsecond window triggers it; self-heals at the
                # next daemon write (MkdirAll recreates).
                # Internal/allocation errors → live → skip: MISREAD,
                # negligible — flock(2) LOCK_NB reports contention as
                # EWOULDBLOCK; anything else is allocation-scale on a box
                # already dying. Fresh-install branch only (upgrades
                # structurally excluded, harness-pinned), and the next
                # first apply self-heals.
                marker_live=false
                if [ -e "$XPF_RUN_DIR/early-input-handoff.done" ]; then
                    if command -v flock >/dev/null 2>&1; then
                        if (umask 077; flock -n "$XPF_RUN_DIR/early-input-handoff.done" true 2>/dev/null); then
                            : # lockable: stale/orphaned, fall through below
                        else
                            marker_live=true
                        fi
                    else
                        : # no flock(1): unprovable, treat as stale (proceed)
                    fi
                fi
                if [ "$marker_live" = true ]; then
                    : # handed off with a live owner (covers raw binaries invisible to systemctl)
                elif command -v nft >/dev/null 2>&1 && nft list table inet xpf_input_barrier 2>/dev/null | grep -qw drop; then
                    : # barrier already enforcing (DROP-bearing); nothing to inject (kernel truth)
                else
                    if systemctl is-active --quiet xpfd 2>/dev/null; then
                        echo "xpf: active xpfd is neither handed off nor guarded; injecting the input barrier until its next apply hands off" >&2
                    fi
                    if ! systemctl enable --now xpf-input-closed.service 2>/dev/null; then
                        echo "xpf: WARNING could not start xpf-input-closed on fresh install;" \
                             "reboot before exposing host services (or run: systemctl enable --now xpf-input-closed)" >&2
                    fi
                fi
            fi
        else
            # Upgrade: do NOT touch the live symlinks. Only recover one that
            # is COMPLETELY absent (not even a broken symlink); never repoint
            # an existing OR dangling link. Repointing while the daemon is up
            # would let the running xpfd resolve a different-version helper,
            # and stealing a dangling link that increment-B repointed to a
            # transiently-missing /var/lib/xpf/versions/<v>/ target would
            # bypass its verify gate. -e alone follows the link (a broken
            # link reads as absent), so guard with -L too.
            #
            # #2000: an ABSENT link is recovered THROUGH versions/current, NOT
            # direct to $STAGED. The hardened layout (#1964 seed, increment-B
            # flip) resolves every live/operator sbin link as
            # /usr/local/sbin/<bin> -> versions/current/<bin>, which is the
            # verified-live version. Recreating an absent link straight to the
            # just-unpacked staged/<bin> would produce a MIXED state before the
            # cut's VERIFY/STOP/FLIP runs: most tools resolve the verified live
            # version while the recovered one resolves the UNVERIFIED staged
            # version (a recovered `cli` would run against the old daemon; a
            # recovered `xpf-userspace-dp` would expose the unverified staged
            # helper). So recover through versions/current/<bin> instead — the
            # same target the flip uses, so the cut's flip is a no-op-shaped
            # repoint. A NEWLY-INTRODUCED managed binary whose target does not
            # yet exist under versions/current (its first upgrade) is LEFT
            # ABSENT until the verified cut populates versions/<v>/ and flips —
            # exposing the unverified staged binary early is exactly what this
            # fix prevents. On a legacy/never-seeded host (no versions/current)
            # all absent links are likewise left for the preinst migration +
            # the cut to establish, never pointed direct to staged here.
            CURRENT_DIR=/var/lib/xpf/versions/current
            for b in $BINS; do
                if [ ! -e "$SBIN/$b" ] && [ ! -L "$SBIN/$b" ]; then
                    if [ -e "$CURRENT_DIR/$b" ]; then
                        mkdir -p "$SBIN"
                        # ln -sfnT replaces a pre-existing symlink atomically
                        # and FAILS (under set -e) rather than nesting a link
                        # INSIDE a real directory at the link path.
                        ln -sfnT "$CURRENT_DIR/$b" "$SBIN/$b"
                    else
                        echo "xpf: sbin link $b absent and no" \
                             "$CURRENT_DIR/$b yet — leaving absent until the" \
                             "verified cut establishes it (not exposing the" \
                             "unverified staged binary early)" >&2
                    fi
                fi
            done

            # === #1981 Option B: PUBLISH the staged generation BEFORE the cut.
            #
            # dpkg has finished unpacking staged/ (Debian Policy 6.7: postinst
            # configure runs after a COMPLETE unpack, while the dpkg frontend
            # lock serializes apt transactions), so the staged set is now whole.
            # Publish it into an immutable staged-gen/<genid>/ and repoint
            # current-gen so the cut reads a single-generation source dpkg is
            # NOT rewriting — closing the dpkg-unpack vs operator-cut torn-read
            # race for ALL FOUR managed binaries. `xpfd publish-generation`
            # takes the host-wide upgrade lock itself; exit 0 = published, exit
            # 2 = lock busy (deferred — another upgrade owns the lock), other =
            # error. A failed/deferred publish must NOT run the auto-cut (the
            # prior generation stays the source; the operator re-publishes and
            # cuts). A publish failure does NOT fail configure (a non-zero
            # postinst half-configures dpkg, worse than a deferred cut).
            #
            # #5284: the DEFERRED/FAILED-publish recovery hints below must name
            # the CORRECT cut verb for THIS node. On a clustered node
            # (/etc/xpf/node-id present) the uncoordinated `xpfd upgrade` is
            # REFUSED (the standalone STOP->FLIP->START cut stops the local
            # daemon without draining to the peer — it would blackhole traffic
            # if the peer is not ready); the operator MUST use the coordinated
            # rolling driver. Emit `--rolling` in the hint on a clustered node
            # so the recovery guidance never points at the bare verb the
            # runtime gate rejects.
            if [ -f /etc/xpf/node-id ]; then
                CUT_HINT="xpfd upgrade --rolling"
            else
                CUT_HINT="xpfd upgrade"
            fi
            PUBLISH_OK=0
            if "$STAGED/xpfd" publish-generation; then
                PUBLISH_OK=1
            else
                rc=$?
                if [ "$rc" = "2" ]; then
                    # Lock busy: preserve the failure and version skew across
                    # reboot, then leave dpkg configured successfully.
                    record_upgrade_failure publish-deferred \
                        "xpfd publish-generation && $CUT_HINT"
                    echo "xpf: staged-generation publish deferred (another upgrade" \
                         "holds the lock) — staged only; after it completes run:" \
                         "xpfd publish-generation && $CUT_HINT" >&2
                else
                    record_upgrade_failure publish-failed \
                        "xpfd publish-generation && $CUT_HINT"
                    echo "xpf: WARNING staged-generation publish failed (rc=$rc) —" \
                         "no new generation published; the cut will read the prior" \
                         "generation or refuse. Re-run: xpfd publish-generation" >&2
                fi
            fi

            # === increment-B cut-over (HA-mode contract, plan §6.3) ===
            #
            # dpkg has refreshed the staging path. Whether we now CUT OVER
            # to it depends on whether this is a clustered node:
            #
            #  - CLUSTERED node (/etc/xpf/node-id present): STAGE-ONLY. We
            #    MUST NOT perform a local single-node cut — that would take
            #    one node down uncoordinated and bypass the rolling drain.
            #    The cut is driven ONLY by `xpfd upgrade --rolling` (operator
            #    or the dogfood deploy driver), which sequences the
            #    controlled drain and itself checks peer liveness. The gate
            #    is keyed on the node-id file ALONE, NOT on a "live cluster"
            #    check: a degraded-HA node (node-id present but peer/daemon
            #    down at apt time) must NOT fall through to a standalone cut.
            #    "live cluster" is a ROLLING-readiness check, not postinst
            #    cut permission.
            #
            #  - STANDALONE node (no node-id): invoke the verified
            #    single-node STOP->FLIP->START cut. This is a bounded,
            #    MEASURED multi-second dataplane gap (the helper cannot be
            #    re-attached today — true zero-gap is future M-mech-2); the
            #    verify gate + atomic flip + rollback still earn their keep
            #    over a blind binary swap. The operator can suppress the
            #    auto-cut with XPF_NO_POSTINST_CUT=1 and run `xpfd upgrade`
            #    manually.
            if [ "$PUBLISH_OK" != "1" ]; then
                # The staged generation was not published (failed or deferred,
                # logged above). Do NOT cut: a cut now would read the PRIOR
                # generation (not this upgrade) or refuse. The operator
                # re-publishes + cuts once the blocker clears.
                echo "xpf: staged generation not published — skipping the cut;" \
                     "recover with: xpfd publish-generation && $CUT_HINT" >&2
            elif [ -f /etc/xpf/node-id ]; then
                echo "xpf: clustered node (node-id present) — staged only;" \
                     "cut over with: xpfd upgrade --rolling" >&2
            elif [ "${XPF_NO_POSTINST_CUT:-}" = "1" ]; then
                echo "xpf: XPF_NO_POSTINST_CUT=1 — staged only;" \
                     "cut over with: xpfd upgrade" >&2
            elif ! flock -n /run/xpf/upgrade.lock true 2>/dev/null && [ -e /run/xpf/upgrade.lock ]; then
                # Another mutator acquired the host-wide lock after preinst.
                # Do not race it or fail dpkg: persist the skew and leave the
                # operator the correct recovery command.
                record_upgrade_failure cut-deferred "$CUT_HINT"
                echo "xpf: another upgrade is in progress — staged only;" \
                     "run '$CUT_HINT' after it completes." >&2
                cat /run/xpf/upgrade.lock 2>/dev/null >&2 || true
            else
                echo "xpf: standalone node — performing verified in-place cut-over" >&2
                # Run the staged binary's upgrade subcommand: it copies
                # staging into the versioned runtime dir, runs the kernel
                # verify-dataplane gate, and on PASS does the atomic
                # STOP->FLIP->START with rollback. The binary itself takes
                # the host-wide upgrade lock (#1965); the flock pre-check
                # above only narrows the TOCTOU window. A REJECT/abort
                # leaves the running daemon untouched. We do NOT fail the
                # package install on a cut-over abort (the operator can
                # re-run xpf-upgrade); surface it loudly instead.
                if ! "$STAGED/xpfd" upgrade; then
                    echo "xpf: WARNING in-place cut-over did not complete." >&2
                    # Record every failed cut, not only lock contention.
                    if [ -e /run/xpf/upgrade.lock ] && \
                       ! flock -n /run/xpf/upgrade.lock true 2>/dev/null; then
                        record_upgrade_failure cut-deferred "$CUT_HINT"
                        echo "xpf: another upgrade is in progress — staged only;" \
                             "run '$CUT_HINT' after it completes." >&2
                    else
                        record_upgrade_failure cut-failed "$CUT_HINT"
                    fi
                    # Safety net (Copilot): the cut STOPs the unit before it
                    # FLIPs. Most failures (preflight/copy/verify) abort
                    # BEFORE the stop and leave the daemon running; the
                    # standalone START failure path auto-rolls-back and
                    # restarts. But a flip/daemon-reload error between STOP
                    # and START could leave the unit stopped. If it is not
                    # active, try to bring it back up so the node is not left
                    # offline after `apt upgrade`.
                    # Boot-guard the systemctl calls (#1965): in a
                    # non-booted env (docker/chroot/bake) systemctl exits
                    # non-zero and, under set -e, would fail the postinst.
                    if [ -d /run/systemd/system ] && ! systemctl is-active --quiet xpfd; then
                        echo "xpf: unit not active after a failed cut-over; restarting" >&2
                        systemctl start xpfd 2>/dev/null || \
                            echo "xpf: WARNING could not restart xpfd; run: xpfd upgrade" >&2
                    fi
                    echo "xpf: inspect with 'journalctl -u xpfd' and re-run: xpfd upgrade" >&2
                else
                    cut_check_output=$("$STAGED/xpfd" version 2>/dev/null || true)
                    cut_check_staged=$(printf '%s\n' "$cut_check_output" |
                        sed -n 's/^xpfd \([^[:space:]]*\).*/\1/p')
                    cut_check_target=$(readlink "$XPF_VERSIONS_DIR/current" 2>/dev/null || true)
                    cut_check_current=${cut_check_target##*/}
                    if [ -n "$cut_check_staged" ] &&
                       [ "$cut_check_staged" = "$cut_check_current" ]; then
                        clear_upgrade_failure
                    else
                        echo "xpf: WARNING cut exited 0 but staged version ${cut_check_staged:-unknown} is not committed at versions/current (${cut_check_current:-unknown})" >&2
                        record_upgrade_failure cut-failed "$CUT_HINT"
                    fi
                fi
            fi
        fi
        # State under /etc/xpf (.configdb, node-id, master.key) is runtime
        # state, NOT package-owned. Do not create, seed, or modify it here.
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
