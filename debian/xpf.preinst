#!/bin/sh
# xpf preinst (#1965 — host-wide upgrade-lock gate, before unpack;
# #1964 — legacy-migration versioned-runtime snapshot, before unpack).
#
# A concurrent operator `xpfd upgrade` (or `xpfd upgrade --rolling`, or a
# `xpfd upgrade kernel arm`) holds the host-wide advisory lock
# /run/xpf/upgrade.lock for its whole cut. If apt unpacked the new package
# while one of those was mid-copy, dpkg would overwrite the dpkg-staged
# binary set under /usr/local/share/xpf/staged/ that the operator's cut is
# reading — a torn source. The preinst runs BEFORE unpack (Debian Policy
# §6.5/§6.6), so this is the correct place to FAIL the package operation
# loudly and atomically (apt aborts before any mutation) if an upgrade is
# already in progress.
#
# This is a non-blocking gate, not full serialization: a flock fd dies when
# preinst exits, so the lock is NOT held during dpkg's unpack, and an
# operator who acquires the (now-free) lock DURING unpack could still read a
# torn staged tree. The torn-binary backstop is the `verify-dataplane`
# kernel gate the in-place cut runs against the COPIED binary before
# StopUnit (a torn/non-execable ELF fails verify and aborts the cut while
# the daemon is still up). Operator guidance: do not run `xpfd upgrade`
# during `apt upgrade`.
#
# #1964 mechanism B (legacy-migration snapshot): a host installed BEFORE
# the #1964 layout existed has /usr/local/sbin/* pointing DIRECTLY at
# staged/, and no versions/current. On such a host the very next upgrade's
# in-place cut would have no rollback target (PreviousVersion==""), and dpkg
# is about to overwrite staged/ — the only copy of the running binaries. So
# BEFORE unpack we snapshot the OLD staged/* into versions/<oldver>/, set
# versions/current -> <oldver>, and atomically repoint sbin THROUGH
# versions/current. This must be SELF-CONTAINED SHELL: the preinst runs
# before the new package is unpacked, so the new (Go-seed-capable) xpfd is
# not on disk yet — only the OLD on-disk binaries + coreutils are available.
# The migration writes NO upgrade journal (the journal is owned by the Go
# cut state machine; a preinst-written journal would confuse a later cut).

set -e

LOCK=/run/xpf/upgrade.lock
STAGED=/usr/local/share/xpf/staged
SBIN=/usr/local/sbin
VERSIONS=/var/lib/xpf/versions
CURRENT="$VERSIONS/current"
# Managed-binary set (#1982). The single source of truth is the Go manifest
# pkg/upgrade/manifest; this literal is kept self-contained on purpose (no
# build-time sed into the tracked checkout). The drift canary
# (TestManagedBinaryDriftCanary, pkg/upgrade/manifest) FAILS the suite if this
# list diverges from manifest.Names(). Edit both together.
BINS="xpfd cli xpf-userspace-dp xpf-day0-config"

# is_safe_segment reports (exit 0) whether $1 is a safe single path segment:
# non-empty, not "." / "..", no leading dot (collides with the runtime
# dotfile namespace + hidden from GC), no "/", and every remaining char in
# the strict allowlist [A-Za-z0-9.:+~_-]. Mirrors pkg/upgrade.ValidateVersion
# Segment so the shell migration keys versions/<ver> by the SAME rule the Go
# cut machine enforces — including the #5713 M41 rejection of '%' (a systemd
# unit specifier that would rewrite the pinned ExecStart path) and the other
# systemd argv metacharacters ($ " ' \ backtick), none of which is legal in a
# Debian/semver version.
is_safe_segment() {
    seg="$1"
    [ -n "$seg" ] || return 1
    case "$seg" in
        .|..) return 1 ;;
        .*) return 1 ;;          # leading dot
        */*) return 1 ;;         # path separator
    esac
    # Strict allowlist: strip every ALLOWED char and see if anything remains.
    # A leftover means a disallowed char — whitespace/control/non-ASCII (all
    # excluded from the set) OR a systemd metacharacter like '%' '$' '"' '\'
    # backtick '*' '?' '[' ']' (#5713 M41). `case` with a glob can't match a
    # class portably, so printf|tr keeps it POSIX.
    #
    # LC_ALL=C is MANDATORY (Copilot): character-class / byte membership is
    # locale-dependent — under a UTF-8 locale a multibyte char could survive
    # the strip and break parity with the Go ValidateVersionSegment (which
    # rejects rune >= 0x80). dpkg runs maintainer scripts under the inherited
    # locale, so we pin C.
    stripped=$(printf '%s' "$seg" | LC_ALL=C tr -d 'A-Za-z0-9.:+~_-')
    [ -z "$stripped" ] || return 1
    return 0
}

# atomic_symlink LINK TARGET — point LINK at TARGET via a temp symlink +
# rename. NOT `ln -sfnT` (which unlinks-then-creates: a non-atomic window
# where a respawn finds no path). mv -f over an existing symlink is atomic.
atomic_symlink() {
    _link="$1"; _target="$2"
    _dir=$(dirname "$_link")
    mkdir -p "$_dir"
    # Clear any stale temp path first (Copilot): if a directory exists at
    # "$_link.tmp", `ln -sf` would create the symlink INSIDE it and the
    # following `mv -f` would move the wrong thing. rm -rf makes the temp an
    # unambiguously fresh symlink target.
    rm -rf "$_link.tmp"
    ln -sf "$_target" "$_link.tmp"
    mv -f "$_link.tmp" "$_link"
}

# sbin_points_through_current reports (exit 0) whether EVERY sbin link
# already resolves through versions/current (so the repoint is a no-op).
sbin_points_through_current() {
    for _b in $BINS; do
        _tgt=$(readlink "$SBIN/$_b" 2>/dev/null || true)
        [ "$_tgt" = "$CURRENT/$_b" ] || return 1
    done
    return 0
}

# repoint_sbin_through_current points every sbin link at
# versions/current/<bin> atomically. Idempotent.
repoint_sbin_through_current() {
    for _b in $BINS; do
        atomic_symlink "$SBIN/$_b" "$CURRENT/$_b"
    done
}

# migrate_legacy_layout snapshots the OLD staged binaries into
# versions/<oldver>/ and repoints current+sbin through it, so the imminent
# in-place cut has a real rollback target. Idempotent and crash-safe; never
# fails the transaction (best-effort — a failure leaves the legacy layout
# untouched, and the cut's own refuse-before-STOP guard (#1964 mechanism C)
# still prevents a no-rollback STOP).
migrate_legacy_layout() {
    # Nothing to snapshot if there is no old staged tree (a pristine box).
    [ -d "$STAGED" ] || return 0

    # ALWAYS ensure sbin resolves through versions/current when current is a
    # valid SYMLINK — a crash AFTER current was created but BEFORE sbin was
    # repointed must complete the repoint on retry (else unpack overwrites
    # staged/ under a daemon still pointed at the staged path). Gate ONLY the
    # snapshot-copy on current's absence.
    #
    # Require current to be a SYMLINK, not merely -e (Copilot): if $CURRENT is
    # a regular file or directory (corruption / manual edit), repointing sbin
    # to "$CURRENT/<bin>" would yield links that do not resolve and break the
    # operator tools. This is best-effort migration, so a non-symlink at
    # $CURRENT means "layout is not ours / is broken" — leave the legacy
    # direct-staged links untouched (the cut's refuse-before-STOP guard still
    # protects the daemon, and the Go seed has the matching non-dir guard).
    if [ -L "$CURRENT" ]; then
        sbin_points_through_current || repoint_sbin_through_current
        return 0
    fi
    if [ -e "$CURRENT" ]; then
        echo "xpf: #1964 legacy migration: $CURRENT exists but is not a symlink" \
             "(corrupt layout); leaving the legacy sbin links untouched." >&2
        return 0
    fi

    # Determine <oldver>. Prefer the running binary's reported version; fall
    # back to a sanitized dpkg $2 if the old binary won't exec (corrupt /
    # lib / arch mismatch). NEVER fail the transaction on an exec error.
    oldver=""
    if [ -x "$STAGED/xpfd" ]; then
        oldver=$("$STAGED/xpfd" version 2>/dev/null | awk '$1=="xpfd"{print $2; exit}' || true)
    fi
    if ! is_safe_segment "$oldver"; then
        # $2 is the old (being-replaced) version on upgrade. Sanitize: keep
        # only the safe path-segment characters; reject if nothing usable
        # remains.
        oldver=$(printf '%s' "${2:-}" | tr -cd 'A-Za-z0-9.:+~_-' || true)
    fi
    if ! is_safe_segment "$oldver"; then
        echo "xpf: #1964 legacy migration: cannot determine a safe old" \
             "version (staged xpfd unrunnable and dpkg version unusable);" \
             "skipping snapshot — the first cut's refuse-before-STOP guard" \
             "still protects the daemon." >&2
        return 0
    fi

    verdir="$VERSIONS/$oldver"
    partial="$verdir.partial"

    mkdir -p "$VERSIONS"

    # Rename-collision retry: a crash AFTER the .partial -> versions/<oldver>
    # rename but BEFORE current was created leaves a populated
    # versions/<oldver> + absent current. A naive re-copy+rename fails
    # ENOTEMPTY and blocks apt. If versions/<oldver> already exists, SKIP
    # copy+rename and jump straight to creating current.
    if [ ! -d "$verdir" ]; then
        rm -rf "$partial"
        mkdir -p "$partial"
        # cp -a preserves modes/timestamps; copy the CONTENTS of staged/.
        if ! cp -a "$STAGED/." "$partial/"; then
            echo "xpf: #1964 legacy migration: copy staged -> partial failed;" \
                 "skipping snapshot (legacy layout left intact)." >&2
            rm -rf "$partial"
            return 0
        fi
        sync
        if ! mv -f "$partial" "$verdir"; then
            echo "xpf: #1964 legacy migration: atomic rename failed;" \
                 "skipping snapshot (legacy layout left intact)." >&2
            rm -rf "$partial"
            return 0
        fi
        sync
    fi

    # current -> <oldver> (relative, within VERSIONS), atomically.
    atomic_symlink "$CURRENT" "$oldver"
    sync
    # Repoint sbin THROUGH versions/current, atomically.
    repoint_sbin_through_current
    sync
    echo "xpf: #1964 legacy migration: snapshotted running version" \
         "$oldver into $verdir; sbin now resolves through versions/current." >&2
}

# #18728 implicit-discard gate (before unpack). The new package makes a
# stateless firewall filter DISCARD every packet that matches no term (the
# Junos implicit final discard); the running build ACCEPTS it. A filter
# written for the old default (an allowlist that meant "and permit the rest",
# a classify-and-pass CoS output filter, a lo0 filter without a final accept)
# would start dropping traffic the moment the new daemon starts -- on a
# standalone node the postinst performs that cut itself, so an `apt upgrade`
# over fxp0 could cut its own session.
#
# This is the EARLIEST point that can still abort cleanly: before unpack, a
# failing preinst leaves the old package installed and the daemon untouched.
# (The postinst's staged `publish-generation` runs the NEW binary, but only
# after dpkg has unpacked it over staged/; failing there half-configures the
# package and only skips the cut.) The new binaries are not on disk yet, so
# the check asks the RUNNING daemon through the OLD cli: `show system
# alarms` lists the config-validation warnings, and every build since #3295
# warns for each attached filter with no terminal catch-all. The WORDING
# tells the semantics of the running build: the pre-#18728 text says "xpf
# accepts traffic matching no term" (the upgrade changes behaviour: refuse);
# the #18728 text says the traffic "is discarded" (no change: allow). The old
# predicate flags a superset of the new one (it did not count modifier-only
# or routing-instance terms as catch-alls), so it can refuse a filter the new
# build would not discard on, never the reverse; the override covers that.
#
# A daemon that cannot be queried (stopped, wedged) is NOT a refusal: that
# is the recovery path, and blocking it would strand the box. The gate says
# so loudly and proceeds.
#
# Override: XPF_UPGRADE_ACCEPT_IMPLICIT_DISCARD=1 (e.g. after reviewing the
# listed filters, or when they really are meant to be deny-by-default).
implicit_discard_gate() {
    if [ "${XPF_UPGRADE_ACCEPT_IMPLICIT_DISCARD:-}" = "1" ]; then
        echo "xpf: #18728 implicit-discard gate overridden" \
             "(XPF_UPGRADE_ACCEPT_IMPLICIT_DISCARD=1)." >&2
        return 0
    fi
    cli_bin="$SBIN/cli"
    if [ ! -x "$cli_bin" ]; then
        echo "xpf: #18728 could not find the running daemon CLI; cannot" \
             "check for filters without a terminal catch-all. Proceeding. After" \
             "the upgrade, unmatched traffic is DISCARDED (Junos implicit final" \
             "discard): check 'show system alarms' for such filters." >&2
        return 0
    fi
    if ! alarms=$(timeout 20 "$cli_bin" -c "show system alarms" 2>/dev/null); then
        echo "xpf: #18728 could not query the running daemon's alarms; cannot" \
             "check for filters without a terminal catch-all. Proceeding. After" \
             "the upgrade, unmatched traffic is DISCARDED (Junos implicit final" \
             "discard): check 'show system alarms' for such filters." >&2
        return 0
    fi
    flagged=$(printf '%s\n' "$alarms" |
        grep 'has no terminal catch-all term; xpf accepts traffic matching no term' || true)
    if [ -z "$flagged" ]; then
        return 0
    fi
    echo "xpf: refusing to upgrade (#18728): the new version DISCARDS traffic that" >&2
    echo "xpf: matches no term of a stateless firewall filter (Junos implicit final" >&2
    echo "xpf: discard). The running version accepts it, and these attached filters" >&2
    echo "xpf: have no terminal catch-all term, so they would start dropping traffic" >&2
    echo "xpf: (a lo0 filter: host traffic, including management on fxp0):" >&2
    printf '%s\n' "$flagged" | sed 's/^[[:space:]]*/xpf:   /' >&2
    echo "xpf: Add a final 'term <name> { then accept; }' to each filter meant to" >&2
    echo "xpf: permit by default (use 'commit confirmed' for lo0 changes), then re-run" >&2
    echo "xpf: the upgrade. To upgrade anyway, set XPF_UPGRADE_ACCEPT_IMPLICIT_DISCARD=1." >&2
    return 1
}

case "$1" in
    upgrade)
        # /run is tmpfs and may lack our subdir on a fresh boot.
        # #16050: 0750/0600, asserted with chmod — mkdir/flock creation mode
        # is umask-dependent, and a readable lock in a traversable dir lets
        # any local user flock it (O_RDONLY suffices) and block upgrades.
        # Runs as root, so tightening a pre-existing permissive dir/file is
        # safe; flock(1) below then creates the lock 0640 at worst, and the
        # explicit chmod pins it to 0600.
        mkdir -p /run/xpf && chmod 0750 /run/xpf
        if [ -e "$LOCK" ]; then chmod 0600 "$LOCK"; fi

        # Non-blocking exclusive lock. If another upgrade holds it, flock
        # exits non-zero and (under set -e) fails the preinst, so apt aborts
        # BEFORE unpacking — the system is left untouched. We immediately
        # release (the subshell exits); the gate only needs to PROVE the
        # lock is free at this instant, not hold it through the unpack (which
        # a preinst fd cannot do across the dpkg boundary anyway).
        if ! (umask 077; flock -n "$LOCK" true); then
            echo "xpf: another in-place upgrade is in progress (holds $LOCK)." >&2
            echo "xpf: refusing to unpack — wait for it to finish, then re-run apt." >&2
            cat "$LOCK" 2>/dev/null >&2 || true
            exit 1
        fi

        # #18728: refuse BEFORE unpack (and before the #1964 snapshot below,
        # which mutates versions/) when the running config has attached
        # filters the new implicit final discard would turn into drops.
        if ! implicit_discard_gate; then
            exit 1
        fi

        # #1964 mechanism B: legacy-migration snapshot. Runs AFTER the lock
        # gate (so a contended upgrade still aborts first) and BEFORE unpack
        # (so the OLD staged/ is still on disk to snapshot).
        #
        # Best-effort: a migration failure must NEVER fail the apt
        # transaction (the function comment promises this). The function runs
        # under the script's `set -e`, and several of its commands are bare
        # (mkdir -p "$VERSIONS", the atomic_symlink ln/mv, sync) — a full
        # disk / EPERM / read-only /var would otherwise abort the preinst and
        # block the upgrade.
        #
        # Two forms that LOOK like they'd work but do NOT, verified against
        # dash + bash (AGY review-011 + the live POSIX set -e test):
        #   - `migrate_legacy_layout "$@" || true` — a function on the left of
        #     `||` runs with `set -e` SUSPENDED for its WHOLE body, so a
        #     failing early command silently continues into later dangerous
        #     lines instead of aborting the migration.
        #   - `if ( set -e; migrate_legacy_layout "$@" ); then` — a command in
        #     an `if` CONDITION also runs with `set -e` suspended, and that
        #     suspension propagates INTO the subshell, so the inner `set -e`
        #     is ignored and early-abort is lost.
        # The only correct form: `set +e` in the parent, run the migration in
        # a subshell that re-enables `set -e` (so a failure aborts the
        # migration EARLY, NOT in a condition context), capture rc, restore
        # `set -e`, then act on rc. The parent absorbs the failure and the apt
        # transaction proceeds.
        set +e
        ( set -e; migrate_legacy_layout "$@" )
        migrate_rc=$?
        set -e
        if [ "$migrate_rc" -ne 0 ]; then
            echo "xpf: #1964 legacy migration did not complete (best-effort);" \
                 "the first cut's refuse-before-STOP guard still protects the" \
                 "daemon. Continuing the upgrade." >&2
        fi
        ;;
    install|abort-upgrade)
        ;;
    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
