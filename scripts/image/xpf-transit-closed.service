# xpf #9852 boot bridge-transit fence.
#
# networkd recreates configured bridge devices from the persisted 10-xpf-*.netdev
# files before xpfd starts. Bridged frames do not consult ip_forward, so the
# nftables xpf_transit_barrier must be installed before networkd is allowed to
# bring up any bridge. xpfd's bring-up later re-installs the same barrier
# idempotently, then removes it only after the #9725 arm gate proves a live XDP
# link. A box whose daemon never starts therefore stays bridge-transit-closed.
#
# This is a REQUIRED dependency of systemd-networkd (via RequiredBy below), not
# merely an ordering hint: if the barrier command fails, systemd-networkd is
# not started and cannot create bridge forwarding. Management and loopback are
# unaffected on the normal success path because the barrier has only a forward
# hook; INPUT/OUTPUT are never touched.
#
# The xpfd subcommand reads no config and takes no daemon lock.
#
# #15147 ownership: on a foreign, never-committed host this barrier is
# released by xpfd at bring-up (removeUnownedBootTransitBarrier15147) once
# the daemon's read-only probe confirms xpf owns nothing there; on an
# appliance-marked, committed, or #14620-recorded host the daemon owns the
# fence and keeps/reinstalls it. If xpfd never starts, the barrier stays —
# fail-closed on an owned box, and the documented residual on a foreign
# host whose daemon is disabled (remove the package to release it).
[Unit]
Description=xpf early bridge-transit barrier (fail-closed before networkd)
DefaultDependencies=no
# /usr/local/sbin/xpfd resolves through /var/lib/xpf/versions/current
# after first-install seeding; on a separate-/var host the fence must not
# exec before that mount. RequiresMountsFor pulls in and orders after the
# backing mount(s) while staying pre-networkd (#15090).
RequiresMountsFor=/var/lib/xpf /usr/local/sbin
After=nftables.service
Before=network-pre.target systemd-networkd.service frr.service xpfd.service
Wants=network-pre.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=30
# Do not prefix this command with `-`: failure MUST fail this required unit,
# and therefore prevent systemd-networkd from creating bridge forwarding.
ExecStart=/usr/local/sbin/xpfd transit-barrier close
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xpf-transit-closed

[Install]
WantedBy=sysinit.target
RequiredBy=systemd-networkd.service
