#!/bin/sh
# xpf (#1930) — LANE-1 kernel-channel promotion gate (runs on EVERY boot).
#
# This is the early-boot half of the A4 channel (r1 Codex Critical-1: the gate
# must actually be invoked, and a REVERT must actually reboot). On an ordinary
# boot (no candidate armed) `xpfd upgrade kernel promote` is a fast no-op
# except that it collects a candidate prune deferred by an earlier revert
# (#16811/#17860: the prune-owed sidecar; journal absent — see the quiet
# branch below). On a candidate trial boot it runs the gate
# (BootCurrent==candidate slot + uname == candidate + verify-dataplane PASS +
# forward beacon PASS):
#   exit 0 -> PROMOTED (durable BootOrder reorder already done) — continue boot.
#   exit 3 -> REVERTED (candidate failed the gate) — reboot NOW; the firmware
#             already cleared BootNext, so the reboot falls through BootOrder to
#             the known-good slot (revert() also restored it).
#   exit 1/other -> infra error — do NOT reboot-loop on a transient failure;
#             log and continue this boot (the candidate is running but
#             un-promoted, so the NEXT plain reboot still falls back to
#             known-good via the firmware-cleared BootNext). Leave the box
#             usable for diagnosis rather than bouncing it.
#
# It runs AFTER xpfd is up (the forward-beacon gate pings through the dataplane,
# which needs xpfd active) but is NOT a hard ordering dependency of xpfd (a stuck
# promote must never wedge the box): see the .service. The promotion is gated on
# verify-dataplane (the #1864 kernel verifier — structural) AND a real forward
# beacon (off-box reachability through the dataplane), so a candidate that boots
# + verifies but cannot forward is reverted, not promoted.

set -u
log() { echo "xpf-kernel-promote: $*" >&2; }

# ---------------------------------------------------------------- authority
#
# THE ARM RECORD IS THE AUTHORITY (#6601 r6). The gate READS which xpfd must
# verify this candidate; nothing here infers one.
#
# Five earlier designs derived "which xpfd is live" from ambient state — $PATH,
# compiled defaults, inode identity, a unit name, then that unit's LoadState —
# and every one of them could be stale after a relocation or a unit switch. The
# last broke concretely: a DISABLED unit still reports LoadState=loaded with
# MainPID=0, so a leftover default unit whose drop-in still pointed at an older
# version passed the arm-time check, and on the candidate boot its stale
# ExecStart was accepted and the stale binary reported the gate clean.
#
# `xpfd upgrade kernel arm` does not have to infer any of this: it IS an xpfd,
# so os.Executable() names the live binary by construction, and it writes that
# path here as part of arming. That converts an unanswerable question ("which
# xpfd is live?") into a recorded fact ("which xpfd armed this candidate?").
#
# The record is a ONE-LINE file on purpose: this gate is POSIX sh with no safe
# JSON parser, so the path it execs must never come out of a JSON value. The
# same value is stamped onto KernelJournal.PromoteBinary and the Go half
# cross-checks the two, so a divergence is caught rather than trusted.
ARM_RECORD="/var/lib/xpf/kernel-promote-binary"

# The kernel-channel journal, consulted for ONE BIT and never for a path (see
# ABSENT MEANS NOTHING IS ARMED, below): is a candidate IN TRIAL right now?
#
# That is `ARMED` (the verified trial), OR `ARMING` when the arm record is
# ALSO present (#16809): arming writes the record (recordPromoteBinary)
# BEFORE the verified ARMED transition, so a record present with the journal
# still at ARMING means the process died — or a landed-but-errored
# SetBootNext's clear never ran — with BootNext actually queued, and THIS
# boot may be the unconfirmed candidate. The record's presence is what the
# shell can prove; the Go half (upgrade.UnconfirmedTrial / Promote)
# convicts on BootCurrent + `uname -r` and gates it. Treating ARMING as
# never-a-trial here (the pre-#16809 rule) made the gate refuse that boot
# as "armed but no record to run" — exactly backwards: it left the
# unverified candidate running with no gate at all.
#
# ARMING WITHOUT a record stays not-a-trial: no binary was ever designated
# to verify it, so there is nothing this gate can run, and the journal
# state alone must not manufacture a loud refusal on every interrupted arm.
# Both state constants are pinned against Go by drift canaries
# (TestPromoteScriptJournalMatchesGo, pkg/upgrade).
KERNEL_JOURNAL="/var/lib/xpf/kernel-upgrade.state"
JOURNAL_ARMED_STATE="ARMED"
JOURNAL_ARMING_STATE="ARMING"

# The DURABLE TRACE a did-not-run outcome leaves behind (#6622).
#
# This gate exits 0 on every path, deliberately: a non-zero exit trips the
# unit's OnFailure= and reboots the box over what may be a transient packaging
# window. Combined with Type=oneshot + RemainAfterExit=yes, that means
# `systemctl status xpf-kernel-promote` reads SUCCESS and the unit stays active
# even when the gate REFUSED and the armed candidate is running unverified. The
# only signal was a journald line, which is time-limited by journal rotation --
# so an operator who armed a candidate, rebooted, and came back the next day saw
# a box on the old kernel and a promote unit reporting success, with nothing
# saying the gate declined or why.
#
# WHICH PATHS WRITE IT, and why that boundary and not another. It is written by
# exactly the paths where THE GATE NEVER RAN xpfd AT ALL:
#
#   * every refuse() -- the loud declines;
#   * the indeterminate-journal WARNING, which is not a refusal but is the same
#     operator problem (a candidate may be armed, the gate did not run, nothing
#     durable said so).
#
# Including the second is not scope creep, it is what makes the record's
# ABSENCE meaningful: if only refuse() wrote one, "no record" would not
# distinguish a clean boot from a boot the gate skipped for the other reason.
#
# It is deliberately NOT written by:
#
#   * the quiet "nothing to promote" branch -- that is the ORDINARY boot, where
#     not running IS the correct outcome, and a file rewritten on every boot is
#     noise that would bury the signal;
#   * the post-exec rc paths -- there the gate DID run xpfd, and the Go half
#     owns its own durable state for those (the journal, the promotion marker
#     and the last-roll record), so a second writer would be a second source.
#
# Format is key=value, ONE LINE PER FIELD, values flattened by one_line: this is
# POSIX sh writing a file Go reads, and the same "a value may legally contain
# the delimiter" hazard that governs the ExecStart parse applies in reverse. A
# systemd ExecStart rendering can legally contain newlines (multiple entries
# render one per line), and an unflattened value would turn one field into
# several bogus records. Go splits on the FIRST '=' so a value containing '='
# survives, and unknown keys are ignored so a newer gate can add fields.
#
# Its path is derived from the journal's directory by ArmRecordPath's sibling
# in Go (RefusalRecordPath) and pinned equal to this literal by a cross-language
# canary (TestPromoteScriptRefusalRecordPathMatchesGo, pkg/upgrade).
REFUSAL_RECORD="/var/lib/xpf/kernel-promote-refusal"

# PROMOTE_UNIT is the systemd unit the record is CROSS-CHECKED against. It is no
# longer where the binary comes from; it is a second opinion, and an absent
# second opinion is not evidence against the record.
#
# It stays PINNED to the default rather than inferred because inferring "which
# unit is the xpf one" would resolve a leftover from a renamed or removed unit
# just as readily as the live one — the same indistinguishable-leftover problem
# that removed the filesystem fallbacks. `xpfd upgrade cut --unit <name>` is a
# supported standalone selector, and such a box is now SUPPORTED here rather
# than refused at arm time: the record carries the authority, xpfd.service
# simply resolves nothing to cross-check against, and the gate runs. (The r5
# arm-time unit check went with the unit-derived authority it protected.)
#
# The name is kept in sync with upgrade.DefaultUnit by a drift canary
# (TestPromoteScriptUnitMatchesDefaultUnit, pkg/upgrade).
PROMOTE_UNIT="xpfd.service"

# Resolve xpfd by EXPLICIT path, never through $PATH (#6541). This is the OUTER
# hop of the promote gate: it runs as root from a systemd oneshot on a candidate
# boot and its exit status decides promote-vs-rollback, so a $PATH entry ordered
# ahead of the real location must not be able to author that decision — and even
# absent an attacker, a stale xpfd left in another PATH directory would verify
# the wrong build against the candidate kernel. (The inner hop, xpfd's own
# `verify-dataplane` exec, is resolved explicitly by resolveVerifyGateBin in
# pkg/upgrade/kernel_linux.go.)
#
# CROSS-CHECK ORDER — the order in which the pinned unit's own answer is sought,
# purely to CONTRADICT the record. It is not a selection order and there is no
# fallback step: when none of it resolves, the record still stands.
#
#   1. /proc/<MainPID>/exe for xpfd.service — the KERNEL's answer for the
#      binary the live daemon is ACTUALLY executing, reached through a
#      structured integer property plus a kernel symlink. No rendered path text
#      is parsed at all, so a runtime root containing a space or a ';' cannot be
#      truncated into some other executable. The pid is bound back to the unit
#      before it is believed (see unit_main_pid_exe).
#
#   2. The ExecStart systemd has for xpfd.service. This is what the cut writes:
#      flip step 6c templates ExecStart=<VersionsDir>/<ver>/xpfd into
#      10-xpf-version.conf on every cut (pkg/upgrade/flip.go), and the shipped
#      base unit carries ExecStart=/usr/local/sbin/xpfd before the first cut.
#
# Both hops obey one rule: UNAMBIGUOUS OR NOTHING. A source that cannot prove
# WHICH executable it is naming stays silent. That rule mattered more when these
# hops SELECTED the binary (a wrong answer authorized the promotion, #6601 r4);
# it still matters, because a wrong answer here now manufactures a false
# DISAGREEMENT and refuses a healthy promotion.
#
# THERE IS DELIBERATELY NO FILESYSTEM FALLBACK (#6601 r5). No compiled-in
# default paths, no "whichever default is usable", no same-inode heuristic.
# Three earlier revisions of this gate each closed one ambiguous filesystem case
# and left another, because the question a defaults fallback is trying to answer
# — WHICH of these files is the live xpfd — is not answerable from the
# filesystem at all once an operator has relocated a root. `--sbin-dir` and
# `--versions-dir` relocate INDEPENDENTLY, and neither relocation REMOVES what
# it left behind, so a leftover is byte-for-byte indistinguishable from a
# healthy install:
#
#   BOTH roots relocated : the old <default sbin>/xpfd symlink AND the old
#                          <default versions>/current/xpfd both survive, and
#                          that symlink still points at that runtime -- so the
#                          two "candidates" are ONE INODE, exactly like a
#                          healthy default layout. A same-inode test calls that
#                          unambiguous; it is a STALE build. (Codex r4 MAJOR-1
#                          reproduced it end to end: live_ran False,
#                          stale_ran True.)
#   ONE root relocated   : exactly one default survives, so "the only usable
#                          default" IS the stale leftover.
#   NEITHER relocated    : healthy -- and systemd answers, so the fallback was
#                          never needed here in the first place.
#
# Refusing is not a lesser outcome, it is the correct one. The refusal takes
# the same non-rebooting infra-error path as an rc=1 from the gate: the box
# stays up and diagnosable, the armed candidate stays UN-PROMOTED, and the next
# plain reboot falls through the firmware-cleared BootNext to the known-good
# slot. Nothing is lost except the guess.
#
# `-f` as well as `-x`: `test -x` is TRUE for a searchable DIRECTORY, and the
# inner hop's validateGateBin rejects a non-regular target, so both hops apply
# the same admission test rather than only claiming to. `-f` also rejects a
# DANGLING symlink (#2176).
#
# systemctl itself is $PATH-resolved, which is correct: it is a
# distribution-owned binary, unlike xpfd -- and the unit pins $PATH to the
# distribution directories, so operator-writable /usr/local/{s,}bin (which
# systemd's DEFAULT PATH ranks FIRST) cannot supply it.

NL='
'
# systemd's REAL field delimiter after `path=` in the ExecStart rendering.
ARGV_SEP=' ; argv[]='

# ------------------------------------------------------- discovery snapshot
#
# Every systemd answer this gate decides on OR reports is read HERE, once,
# before anything is decided (#6601 r7 MINOR-3).
#
# The previous revision suppressed each query's failure at the point of use
# (`2>/dev/null || return 0`) and then RE-QUERIED systemctl to build the refusal
# message. A query that failed during discovery and succeeded on the re-read was
# therefore reported as "the unit IS known to systemd", and the operator was
# advised to fix an ExecStart that had never been consulted — the message
# described a system state the decision was never made on. Facts and advice now
# come from this snapshot, so what is printed is what was decided on, by
# construction rather than by care.
#
# The ONE deliberate exception is the MainPID RE-READ inside unit_main_pid_exe:
# that read exists precisely to detect a pid that moved AFTER the snapshot, so
# it must be fresh. It is a comparison against the snapshot, never a substitute
# for it.
SNAP_QUERY_FAILED=0

if SNAP_LOADSTATE=$(systemctl show --property=LoadState --value "$PROMOTE_UNIT" 2>/dev/null); then
    SNAP_LOADSTATE_SHOW="$SNAP_LOADSTATE"
else
    SNAP_LOADSTATE=""
    SNAP_LOADSTATE_SHOW="<systemctl failed>"
    SNAP_QUERY_FAILED=1
fi

if SNAP_MAINPID=$(systemctl show --property=MainPID --value "$PROMOTE_UNIT" 2>/dev/null); then
    SNAP_MAINPID_SHOW="$SNAP_MAINPID"
else
    SNAP_MAINPID=""
    SNAP_MAINPID_SHOW="<systemctl failed>"
    SNAP_QUERY_FAILED=1
fi

if SNAP_CONTROLGROUP=$(systemctl show --property=ControlGroup --value "$PROMOTE_UNIT" 2>/dev/null); then
    SNAP_CONTROLGROUP_SHOW="$SNAP_CONTROLGROUP"
else
    SNAP_CONTROLGROUP=""
    SNAP_CONTROLGROUP_SHOW="<systemctl failed>"
    SNAP_QUERY_FAILED=1
fi

if SNAP_EXECSTART=$(systemctl show --property=ExecStart --value "$PROMOTE_UNIT" 2>/dev/null); then
    SNAP_EXECSTART_SHOW="$SNAP_EXECSTART"
else
    SNAP_EXECSTART=""
    SNAP_EXECSTART_SHOW="<systemctl failed>"
    SNAP_QUERY_FAILED=1
fi

# unit_facts renders the snapshot. The refusal is the ONLY operator-visible
# signal this gate produces — it exits 0 deliberately, so `systemctl status
# xpf-kernel-promote` reads SUCCESS — so policy prose without the values systemd
# actually returned is not actionable (#6601 r5 MINOR-2).
unit_facts() {
    printf 'unit=%s LoadState=[%s] MainPID=[%s] ControlGroup=[%s] ExecStart=[%s]' \
        "$PROMOTE_UNIT" "$SNAP_LOADSTATE_SHOW" "$SNAP_MAINPID_SHOW" \
        "$SNAP_CONTROLGROUP_SHOW" "$SNAP_EXECSTART_SHOW"
}

# set_cause_advice sets CAUSE and ADVICE from the snapshot. The advice BRANCHES:
# telling an operator to fix an ExecStart when systemctl could not be consulted
# at all points at the wrong system (#6601 r5 MINOR-2), and telling them to fix
# a unit this host deliberately does not use is no better.
CAUSE=""
ADVICE=""
set_cause_advice() {
    if [ "$SNAP_QUERY_FAILED" -ne 0 ]; then
        CAUSE="systemctl could not be consulted at all (missing, errored, or it"
        CAUSE="$CAUSE returned nothing), so NOTHING is known about $PROMOTE_UNIT"
        CAUSE="$CAUSE on this box and the record has no second opinion"
        ADVICE="Check that systemd is running and systemctl works in this boot"
        ADVICE="$ADVICE (\`systemctl show --property=LoadState $PROMOTE_UNIT\`);"
        ADVICE="$ADVICE this is a systemd-availability problem, NOT a"
        ADVICE="$ADVICE $PROMOTE_UNIT configuration problem. Then re-arm from the"
        ADVICE="$ADVICE live xpfd (\`xpfd upgrade kernel arm\`), which rewrites"
        ADVICE="$ADVICE the record"
    elif [ "$SNAP_LOADSTATE" = not-found ]; then
        CAUSE="$PROMOTE_UNIT is not-found, so either this host runs xpfd under a"
        CAUSE="$CAUSE different unit (\`xpfd upgrade cut --unit <name>\`) or xpf"
        CAUSE="$CAUSE is not installed here; the record is the only authority on"
        CAUSE="$CAUSE such a box and there is nothing to cross-check it against"
        ADVICE="Re-arm from the live xpfd (\`xpfd upgrade kernel arm\`), which"
        ADVICE="$ADVICE rewrites the record from the binary doing the arming"
    else
        CAUSE="$PROMOTE_UNIT IS known to systemd (LoadState=$SNAP_LOADSTATE), so"
        CAUSE="$CAUSE xpf IS installed here"
        ADVICE="Fix $PROMOTE_UNIT so its ExecStart names the live xpfd as a"
        ADVICE="$ADVICE single unambiguous absolute path, then re-arm from the"
        ADVICE="$ADVICE live xpfd (\`xpfd upgrade kernel arm\`), which rewrites"
        ADVICE="$ADVICE the record"
    fi
}

# refuse prints the loud, fact-carrying refusal and takes the NON-REBOOTING
# infra-error path. exit 0 is DELIBERATE: a non-zero exit trips the unit's
# OnFailure= and reboots the box over what may be a transient packaging window,
# and the firmware already cleared BootNext, so the next plain reboot falls back
# to known-good on its own.
# one_line flattens a value onto a single line so it cannot forge extra fields
# in the key=value record. Newlines are the real case (a multi-entry ExecStart
# renders one per line); tabs and CRs are folded for the same reason at no extra
# cost. `tr` is a distribution binary on the unit's pinned PATH, like systemctl.
one_line() {
    printf '%s' "$1" | tr '\n\r\t' '   '
}

# record_refusal writes the durable trace. $1 is the disposition, the rest is
# the human reason.
#
# BEST-EFFORT, ALWAYS. Every step is suppressed and the function always returns
# success: this runs on a candidate boot whose whole problem may be that the
# filesystem is not what the gate expected, and a gate that changed its exit
# path because it could not write a DIAGNOSTIC would convert an observability
# gap into an availability one. The caller's exit 0 must be reached either way.
#
# Written to a temp file and renamed so a reader never sees a half-written
# record; the rename is within one directory, so it is atomic.
record_refusal() {
    rr_disposition=$1
    shift
    rr_dir=${REFUSAL_RECORD%/*}
    mkdir -p "$rr_dir" 2>/dev/null || return 0
    rr_tmp="$REFUSAL_RECORD.tmp"
    {
        printf 'version=1\n'
        printf 'disposition=%s\n' "$rr_disposition"
        printf 'refused_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)"
        # The boot this happened on. An early-boot clock can be wrong (no RTC,
        # no NTP yet), so the timestamp alone cannot answer "was this THIS
        # boot?"; the boot id can, and it costs one read of a kernel file.
        printf 'boot_id=%s\n' "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
        printf 'journal_state=%s\n' "$(journal_state)"
        printf 'unit=%s\n' "$PROMOTE_UNIT"
        printf 'load_state=%s\n' "$(one_line "$SNAP_LOADSTATE_SHOW")"
        printf 'main_pid=%s\n' "$(one_line "$SNAP_MAINPID_SHOW")"
        printf 'control_group=%s\n' "$(one_line "$SNAP_CONTROLGROUP_SHOW")"
        printf 'exec_start=%s\n' "$(one_line "$SNAP_EXECSTART_SHOW")"
        printf 'reason=%s\n' "$(one_line "$*")"
        # CAUSE and ADVICE are set by set_cause_advice on the refuse() path and
        # empty elsewhere. They are separate fields rather than appended to the
        # reason so a reader can render the diagnosis apart from the event, and
        # so the branch the advice took stays legible.
        printf 'cause=%s\n' "$(one_line "$CAUSE")"
        printf 'advice=%s\n' "$(one_line "$ADVICE")"
    } > "$rr_tmp" 2>/dev/null || { rm -f "$rr_tmp" 2>/dev/null; return 0; }
    mv -f "$rr_tmp" "$REFUSAL_RECORD" 2>/dev/null || rm -f "$rr_tmp" 2>/dev/null
    return 0
}

refuse() {
    set_cause_advice
    record_refusal refused "$*"
    log "ERROR: $* REFUSING to promote: this gate does NOT fall back to" \
        "inferring which xpfd is live, because a runtime left behind by" \
        "--versions-dir/--sbin-dir relocation or a unit switch is" \
        "indistinguishable from a live one and executing the stale half would" \
        "verify the candidate kernel against the wrong dataplane. The armed" \
        "candidate stays un-promoted and the next plain reboot falls back to" \
        "the known-good slot. $CAUSE. FACTS: $(unit_facts). $ADVICE."
    exit 0
}

# pid_in_unit_cgroup is TRUE when process $1 is a member of control group $2.
#
# /proc/<pid>/cgroup lines are "<hierarchy-id>:<controllers>:<path>" -- cgroup
# v2 renders a single "0::<path>" line, v1 one line per controller. Match the
# PATH field EXACTLY (or as the parent of a delegated subgroup), not by
# substring, so a same-prefix sibling cannot satisfy it.
pid_in_unit_cgroup() {
    [ -r "/proc/$1/cgroup" ] || return 1
    while IFS= read -r cgline; do
        case "$cgline" in
            *:"$2" | *:"$2"/*) return 0 ;;
        esac
    done < "/proc/$1/cgroup"
    return 1
}

# unit_main_pid_exe prints the absolute path of the binary xpfd.service is
# actually running, or nothing. MainPID is a structured integer property and
# /proc/<pid>/exe is a kernel symlink, so nothing here parses a rendered path.
#
# A pid is a NUMBER, though, and a number is not an identity (#6601 r4
# MAJOR-2). If xpfd.service exits between the MainPID read and the readlink and
# the kernel recycles that pid onto an unrelated process, /proc/<pid>/exe names
# that process's binary. The basename guard alone does not close that; it only
# requires the recycled binary to be CALLED `xpfd`. So bind the pid back to the
# UNIT before believing it, and do the binding AFTER the readlink so a recycle
# that happens DURING the sequence is caught rather than raced past:
#
#   * membership in xpfd.service's OWN control group. systemd reports the
#     unit's cgroup as a structured property and the kernel reports each
#     process's cgroup in /proc/<pid>/cgroup, so this is an association the
#     kernel itself vouches for -- a recycled pid belongs to whatever cgroup
#     its new owner was forked into, not to this unit's. It also rejects an
#     unrelated same-numbered process seen through a mismatched /proc.
#   * MainPID RE-READ and still the SAME positive pid. This is the one query
#     deliberately not taken from the discovery snapshot: its entire purpose is
#     to observe a pid that moved after the snapshot was taken.
#
# What a wrong answer costs changed with the r6 redesign and the binding is kept
# for the new cost: this hop no longer selects the binary, so believing an
# impostor now manufactures a false DISAGREEMENT with the record and refuses a
# healthy promotion, rather than handing an impostor the promote decision.
unit_main_pid_exe() {
    pid="$SNAP_MAINPID"
    case "$pid" in
        '' | *[!0-9]*) return 0 ;;
    esac
    [ "$pid" -gt 0 ] || return 0
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 0
    case "$exe" in
        # A binary replaced on disk reads back as "<path> (deleted)". It cannot
        # be re-executed, so yield nothing rather than a mangled path. Stated
        # for clarity, not because it is load-bearing alone: that string also
        # fails the basename guard below and the regular-file admission test,
        # so no test claims this line is the sole rejector (#6601 r4 MINOR).
        *' (deleted)') return 0 ;;
    esac
    case "$exe" in
        # Basename guard. Every layout this gate supports names the artifact
        # `xpfd` (the manifest basename; flip writes <VersionsDir>/<ver>/xpfd
        # and <SbinDir>/xpfd), so this costs nothing.
        /*/xpfd) ;;
        *) return 0 ;;
    esac

    case "$SNAP_CONTROLGROUP" in
        /*) ;;
        *) return 0 ;;
    esac
    pid_in_unit_cgroup "$pid" "$SNAP_CONTROLGROUP" || return 0

    pid2=$(systemctl show --property=MainPID --value "$PROMOTE_UNIT" 2>/dev/null) || return 0
    [ "$pid2" = "$pid" ] || return 0

    printf '%s\n' "$exe"
}

# unit_exec_start prints the absolute path systemd launches xpfd.service from,
# or NOTHING.
#
# `systemctl show --property=ExecStart --value` renders each entry as
#
#     { path=/usr/sbin/sshd ; argv[]=/usr/sbin/sshd -D $OPTS ; ignore_errors=no ; ... }
#
# and the property printer substitutes the stored path RAW (`path=%s`), with no
# escaping. systemd PERMITS an executable path containing a space or a ';', so a
# parse that stops at the first one does not merely fail to resolve -- it
# resolves to a SHORTER, DIFFERENT path (#6601 r4: `path=/opt/relocated live/xpfd`
# yielded `/opt/relocated`). Cut at the literal " ; argv[]=" systemd emits
# immediately after the field instead, and give up unless it occurs EXACTLY ONCE
# -- a second occurrence means the path (or an argument) contains the delimiter
# itself and no textual parse can recover the boundary.
#
# Multiple ExecStart entries render one per LINE. The shipped Type=simple unit
# cannot validly carry more than one, but an operator-overridden Type=oneshot
# can, and its FIRST entry need not be xpfd -- so more than one line is
# ambiguous, not "take the first".
#
# On a REAL multi-entry render the delimiter-count rule above already rejects
# the value (each entry carries its own " ; argv[]="), so the newline guard is
# not the sole rejector there and no test should claim it is (#6601 r4 MINOR).
# It is kept because it is the ONLY thing that rejects a render carrying just
# one delimiter across several lines, where the count rule passes and the parse
# would silently adopt the first entry.
unit_exec_start() {
    raw="$SNAP_EXECSTART"
    [ -n "$raw" ] || return 0
    case "$raw" in
        *"$NL"*) return 0 ;;
    esac
    case "$raw" in
        '{ path='*"$ARGV_SEP"*)
            rest=${raw#'{ path='}
            case "${rest#*"$ARGV_SEP"}" in
                *"$ARGV_SEP"*) return 0 ;;
            esac
            path=${rest%%"$ARGV_SEP"*}
            ;;
        /*)
            # A bare (unstructured) rendering. Accepted ONLY when the whole
            # value is a single absolute path; arguments, or an @ / - / + / !
            # exec prefix, leave the executable unidentifiable. A prefix also
            # fails the `/*` match above and lands in the catch-all.
            #
            # Reject ANY whitespace, not just a space: a tab separates a path
            # from its arguments just as well, and "whole path only" has to be
            # true rather than approximately true (#6601 r4 audit note).
            # [[:space:]] covers space/tab/newline/CR/FF/VT and is honoured by
            # dash and busybox sh, the two shells this early-boot path runs
            # under.
            case "$raw" in
                *[[:space:]]* | *';'*) return 0 ;;
            esac
            path=$raw
            ;;
        *) return 0 ;;
    esac
    case "$path" in
        /*) printf '%s\n' "$path" ;;
    esac
}

# journal_state answers ONE question about the kernel-channel journal — is a
# candidate IN TRIAL? — and echoes exactly one of:
#
#   absent        : no journal at all. Nothing was ever armed here.
#   not-armed     : a journal exists but is not at a trial state
#                   (PREFLIGHT/INSTALLED mid-run, or a terminal
#                   PROMOTED/REVERTED that has not been cleared yet), OR it
#                   is ARMING *with no arm record present* — prepared intent
#                   whose one-shot was never shown to be queued (#16809).
#   arming        : ARMING *with the arm record present*: the record is
#                   written before the ARMED transition, so a one-shot may
#                   have been queued without a verified ARMED record
#                   (#16809). Only returned when the record exists; with the
#                   record absent ARMING folds into not-armed, because there
#                   is no designated binary to gate with either way. The Go
#                   half convicts on BootCurrent + uname -r.
#   armed         : a candidate kernel IS in a verified trial right now.
#   indeterminate : a journal exists but cannot be read as one. Absence of
#                   evidence is not evidence of absence, so this is NOT folded
#                   into "not-armed".
#
# A BOOLEAN, NEVER A PATH. The journal also carries PromoteBinary, and reading
# THAT here would put the executed path back inside a JSON value parsed by sh —
# the exact "a value may contain the delimiter" class that MAJOR-1 was about,
# and the reason the one-line sidecar exists. This function must never grow a
# path extraction.
#
# The match is line-scoped and requires the closing quote, so `"ARMING"` and
# a hypothetical `"ARMED_X"` do not satisfy the ARMED pattern, and an escaped
# occurrence inside some other value (`\"state\":`) cannot either.
journal_state() {
    [ -e "$KERNEL_JOURNAL" ] || { echo absent; return 0; }
    if [ ! -f "$KERNEL_JOURNAL" ] || [ ! -r "$KERNEL_JOURNAL" ]; then
        echo indeterminate
        return 0
    fi
    jline=""
    # `|| [ -n "$jline" ]` so a final line with no trailing newline is still
    # examined: json.MarshalIndent output ends at the closing brace with no
    # newline, and a compact single-line rendering would otherwise never be
    # read at all.
    while IFS= read -r jline || [ -n "$jline" ]; do
        case "$jline" in
            *'"state":'*"\"$JOURNAL_ARMED_STATE\""*) echo armed; return 0 ;;
            *'"state":'*"\"$JOURNAL_ARMING_STATE\""*)
                if [ -f "$ARM_RECORD" ] && [ -r "$ARM_RECORD" ]; then
                    echo arming
                else
                    echo not-armed
                fi
                return 0 ;;
        esac
        jline=""
    done < "$KERNEL_JOURNAL"
    echo not-armed
}

# gate_result maps the xpfd promote exit status to this unit's outcome
# (#17860). It is SHARED by the armed-candidate exec at the bottom and the
# ordinary-boot deferred-prune collector exec below: both run the same Go
# entry point (`upgrade kernel promote`), so both take the same
# exit-0-on-every-path contract — a non-zero unit exit trips OnFailure= and
# reboots the box over what may be a transient packaging window.
gate_result() {
    case "$1" in
        0)
            log "promotion gate: clean (promoted or ordinary boot)"
            exit 0
            ;;
        3)
            log "promotion gate: REVERT — candidate failed; rebooting to known-good slot"
            # The firmware already consumed BootNext and revert() restored the
            # known-good slot to the BootOrder front, so this reboot lands on
            # known-good. Use --no-wall; this is an unattended recovery reboot.
            systemctl reboot --no-wall || reboot
            # Exit 0: issuing the recovery reboot IS the intended outcome of a
            # revert, so the unit must NOT record failure here — otherwise
            # OnFailure= (the hang/timeout recovery) would double-fire a second
            # reboot. The OnFailure handler is reserved for the case where this
            # script never reaches its own reboot (SIGTERM on TimeoutStartSec).
            exit 0
            ;;
        *)
            log "promotion gate: infra error (rc=$1); NOT rebooting (avoid a bounce loop) — candidate is un-promoted, next plain reboot falls back to known-good"
            exit 0
            ;;
    esac
}

XPFD=""
XPFD_SRC=""

# usable: the admission test, applied identically to every candidate -- an
# existing, REGULAR, executable file (see the -f/-x note above).
usable() {
    [ -n "$1" ] && [ -f "$1" ] && [ -x "$1" ]
}

try_candidate() {
    [ -z "$XPFD" ] || return 0
    usable "$1" || return 0
    XPFD="$1"
    XPFD_SRC="$2"
}

# same_file is TRUE when two paths denote the same FILE. The cross-check needs
# file identity, not string equality, because its two sides are produced by
# mechanisms that disagree about symlinks (#6601 r8 MAJOR-1):
#
#   * the record comes from os.Executable() -> /proc/self/exe, which the kernel
#     reports FULLY RESOLVED. On the `flip` 6b layout that is the concrete
#     <VersionsDir>/<ver>/xpfd, never the <SbinDir>/xpfd symlink it was exec'd
#     through.
#   * ExecStart is whatever systemd was configured with, and BEFORE THE FIRST
#     CUT that is the shipped base unit's `ExecStart=/usr/local/sbin/xpfd` --
#     the symlink `seed-runtime` creates on first install (debian/xpf.postinst
#     -> pkg/upgrade/runtime/seed.go). flip step 6c only pins the concrete
#     versioned path into 10-xpf-version.conf AFTER a cut.
#
# So on every freshly installed or freshly baked box the two names denote ONE
# file and differ as strings. A string compare called that a "disagreement" and
# refused a healthy candidate -- and it did so precisely when xpfd.service is
# NOT running, because that is when the MainPID hop is silent and ExecStart is
# the only cross-check left. xpfd.service failing to start is a first-class
# expected outcome of a candidate kernel that breaks the AF_XDP shim (the unit's
# ExecStartPre runs verify-dataplane), which is the exact scenario this channel
# exists to catch: the revert guard was made unable to fire.
#
# `-ef` is dev+inode identity, which is precisely the question here. It is NOT
# the banned same-inode SELECTION heuristic: that one tried to decide WHICH of
# two leftover defaults was live, which the filesystem cannot answer. This
# compares a known authority against a second opinion, where identity settles
# it -- and it cannot launder the r6 sequence, because a stale drop-in naming an
# OLDER version names a DIFFERENT file and still refuses.
#
# Verified honoured by /bin/sh, dash and busybox sh. `readlink -f` is a fallback
# so a shell without `-ef` degrades to canonical-path equality rather than to a
# false refusal. Both ARGUMENTS are paths that have already passed `usable`
# (there is exactly one caller, and a test asserts that).
same_file() {
    [ "$1" = "$2" ] && return 0
    if [ "$1" -ef "$2" ] 2>/dev/null; then
        return 0
    fi
    sf_a=$(readlink -f -- "$1" 2>/dev/null) || sf_a=""
    sf_b=$(readlink -f -- "$2" 2>/dev/null) || sf_b=""
    [ -n "$sf_a" ] && [ "$sf_a" = "$sf_b" ]
}

# ---------------------------------------------------------------- selection
#
# ABSENT MEANS NOTHING IS ARMED — BUT ONLY IF THE JOURNAL AGREES (#6601 r7).
#
# The record is written by arming (BEFORE the ARMED transition) and removed with
# the journal, so in every state the Go half can produce, a record exists for as
# long as a candidate is armed. Its absence is therefore normally a definitive
# statement that there is nothing to promote — which is also the only state in
# which not running the gate is harmless.
#
# "Normally" is the whole problem. Deriving "nothing is armed" from the ABSENCE
# of a file is an inference from ambient state, and this issue exists because
# every such inference eventually met a box that broke it. This one breaks
# whenever the two files desync out of band, which takes losing ONE of them:
#
#   * a /var/lib/xpf restored from a backup taken before the arm, or restored
#     only partially;
#   * a stray cleanup (tmpfiles rule, an operator `rm`, a housekeeping sweep)
#     that removes the sidecar and leaves the journal;
#   * a candidate armed by a build PREDATING the sidecar, upgraded through the
#     #1917 binary channel before the candidate boot: the journal says ARMED
#     and no record was ever written.
#
# Note what is NOT in that list: `xpfd upgrade kernel arm --journal <elsewhere>`
# moves BOTH files together (Go derives the sidecar from the journal's
# directory), so the gate finds neither and takes the quiet branch. That is a
# real trap, but a DIFFERENT one -- the boot unit hardcodes this script with no
# way to pass a journal path, so a non-default --journal is structurally
# unpromotable, exactly as it was before this gate existed. Nothing about THIS
# gate changed: it is closed at the other end, where the ambiguity actually is.
# `KernelRunner.Arm` REFUSES a non-default journal path outright (#6631,
# ErrKernelJournalUnpromotable), so the state is no longer reachable from a
# supported operation. Do not cite it as the motivation for the check below.
#
# In the desyncs that ARE reachable, a candidate is armed, the gate silently
# does not run, the candidate is never promoted, and the next reboot reverts it
# — reported by a line that reads like an ordinary boot.
#
# Not promoting is the SAFE direction, so this is availability and honesty
# rather than security. It is nonetheless exactly the laundering the r5 MINOR-1
# work removed from the not-found-unit branch: an armed candidate going
# UNVERIFIED behind a reassuring log line. So the quiet exit is now conditional
# on the journal agreeing that nothing is armed, and the divergent state is
# LOUD.
RECORDED=""
if [ -f "$ARM_RECORD" ] && [ -r "$ARM_RECORD" ]; then
    # `read` stops at the first newline; the record is one line by construction.
    #
    # `|| [ -n "$RECORDED" ]` because `read` returns NON-ZERO at EOF-without-
    # newline AFTER setting the variable (#6601 r8 MINOR-2). Go writes a
    # trailing newline, but a record restored, hand-edited or copied without one
    # is a perfectly good absolute path, and discarding it produced the
    # actively-misleading "does not contain an absolute path" refusal.
    # journal_state already handles this exact case a few lines up; the two
    # reads now agree.
    { IFS= read -r RECORDED || [ -n "$RECORDED" ]; } < "$ARM_RECORD" 2>/dev/null || RECORDED=""
fi

if [ ! -e "$ARM_RECORD" ]; then
    JSTATE=$(journal_state)
    case "$JSTATE" in
        armed)
            refuse "a candidate kernel is ARMED in $KERNEL_JOURNAL but the arm" \
                "record $ARM_RECORD is ABSENT, so the promotion gate did NOT" \
                "run and that candidate is running UNVERIFIED. Arming writes" \
                "the record before it records ARMED and clears it with the" \
                "journal, so the two desynced out of band -- a non-default" \
                "--journal path, a restored or partially cleaned /var/lib/xpf," \
                "or an interrupted clear."
            ;;
        indeterminate)
            record_refusal indeterminate "the arm record $ARM_RECORD is absent" \
                "and $KERNEL_JOURNAL exists but cannot be read as a journal, so" \
                "this gate could not establish whether a candidate kernel is armed"
            log "WARNING: the promotion gate did NOT run. The arm record" \
                "$ARM_RECORD is absent, and $KERNEL_JOURNAL exists but cannot" \
                "be read as a journal, so this gate cannot establish whether a" \
                "candidate kernel is armed. If one IS armed it is running" \
                "UNVERIFIED and will NOT be promoted; the next plain reboot" \
                "falls back to the known-good slot. Check $KERNEL_JOURNAL is a" \
                "readable regular file, then re-arm from the live xpfd."
            exit 0
            ;;
    esac
    log "no kernel candidate in trial recorded ($ARM_RECORD absent, $KERNEL_JOURNAL" \
        "$JSTATE); nothing to promote"
    # #17860: "nothing to promote" is not "nothing to do". A revert that
    # deferred its candidate prune while the candidate was the running kernel
    # (#14165) persisted that debt in the prune-owed sidecar and CLEARED the
    # journal — this ordinary boot, journal absent, is exactly where the Go
    # half collects it (settlePruneOwed). Before #17860 this branch exited
    # here, so the INSTALLED boot entry point never ran the collector and the
    # #16811 acceptance (exactly one prune on boot 2) was test-only-green:
    # only a direct `xpfd upgrade kernel promote` ever collected the debt.
    #
    # Scoped to an ABSENT journal on purpose. A PRESENT non-trial journal
    # ($JSTATE=not-armed: mid-run, terminal-uncleared, or record-less ARMING
    # folded in per #16809) keeps the quiet exit above: the Go half defers
    # on those states itself (terminal journals take no settle), and a
    # record-less ARMING boot must not have a gate run manufactured from
    # journal state alone (#16809) — its Gate 2b would revert a healthy
    # candidate because the live binary is not the one the dead arm
    # designated (#6601 r6). The debt survives those boots and is collected
    # on the next absent-journal boot.
    if [ "$JSTATE" != absent ]; then
        exit 0
    fi
    # No arm record exists here, so there is no recorded authority to exec.
    # The ONLY sanctioned resolvers are the same UNAMBIGUOUS-OR-NOTHING
    # systemd hops the cross-check below uses — never a filesystem fallback
    # (#6601 r5): a leftover default-path xpfd is indistinguishable from the
    # live one. MainPID -> /proc/<pid>/exe is the kernel's answer for what
    # the live daemon is executing; ExecStart is what the cut pinned. When
    # neither resolves there is honestly no binary this gate may run: say so
    # loudly and leave the debt for the next boot (fail-safe — the prune is
    # destructive, so skipping it is the safe direction).
    MAIN_EXE="$(unit_main_pid_exe)"
    EXEC_EXE="$(unit_exec_start)"
    # Unambiguous-or-nothing, like the armed cross-check below: if BOTH
    # hops resolve but name DIFFERENT files (stale drop-in vs running
    # daemon), no binary may run — a stale binary could settle the debt
    # with pre-#17860 logic (Rev18063Opus B3).
    if [ -n "$MAIN_EXE" ] && [ -n "$EXEC_EXE" ] && ! same_file "$MAIN_EXE" "$EXEC_EXE"; then
        log "WARNING: this ordinary boot may owe a deferred candidate prune, but" \
            "the live-daemon hops disagree (MainPID -> $MAIN_EXE, ExecStart ->" \
            "$EXEC_EXE), so the deferred-cleanup collector did NOT run this" \
            "boot; it retries on the next boot. FACTS: $(unit_facts)."
        exit 0
    fi
    try_candidate "$MAIN_EXE" "systemd MainPID -> /proc/<pid>/exe for $PROMOTE_UNIT"
    try_candidate "$EXEC_EXE" "systemd ExecStart for $PROMOTE_UNIT"
    ORDINARY="$XPFD"
    if [ -z "$ORDINARY" ]; then
        log "WARNING: this ordinary boot may owe a deferred candidate prune, but" \
            "no live xpfd resolves via $PROMOTE_UNIT (MainPID, ExecStart), so" \
            "the deferred-cleanup collector did NOT run this boot; it retries" \
            "on the next boot. FACTS: $(unit_facts)."
        exit 0
    fi
    log "ordinary boot: running the deferred-prune collector via $ORDINARY ($XPFD_SRC)"
    "$ORDINARY" upgrade kernel promote
    gate_result $?
fi

# #16809: the record is present but the journal never reached ARMED. That is
# the unconfirmed-trial shape (process death between SetBootNext and the
# ARMED rename, or a landed-but-errored SetBootNext): BootNext may have been
# queued, and THIS boot may be the candidate. Do NOT refuse and do NOT take
# the quiet exit — fall through and run the recorded binary; the Go half
# (Promote/UnconfirmedTrial) convicts on BootCurrent + uname -r and either
# gates the candidate or no-ops as an ordinary boot. Refusing here (the
# pre-#16809 "ARMING is never a trial" reading) is the one outcome that
# leaves an unverified candidate running with no gate at all. A journal in
# any OTHER non-ARMED state with a record present keeps the existing flow:
# the Go half no-ops or resolves it, exactly as a verified-ARMED journal's
# gate run does.
JSTATE=$(journal_state)
if [ "$JSTATE" = arming ]; then
    log "journal is ARMING with an arm record present — a one-shot may have been" \
        "queued without a verified ARMED record (#16809); running the recorded" \
        "gate, which classifies this boot on BootCurrent + uname -r"
fi

case "$RECORDED" in
    /*) ;;
    *)
        refuse "the arm record $ARM_RECORD is present but does not contain an" \
            "absolute path (got [${RECORDED}]), so a candidate kernel may be" \
            "armed and this gate has no binary to verify it with."
        ;;
esac

if ! usable "$RECORDED"; then
    refuse "the arming recorded $RECORDED as the xpfd that must verify this" \
        "candidate, but that path is not an executable regular file now."
fi

# CROSS-CHECK, never an alternative. When the pinned unit independently resolves
# a binary it must AGREE with the record. Disagreement is the r6 sequence
# exactly -- a stale leftover unit still naming an older version -- so it
# refuses rather than picking a side. When the unit resolves NOTHING (a box cut
# with `--unit <name>`, or a stopped unit) there is simply nothing to contradict
# the record, and absence of a cross-check is not evidence against the
# authority: the record stands.
CROSS=""
try_candidate "$(unit_main_pid_exe)" "systemd MainPID -> /proc/<pid>/exe for $PROMOTE_UNIT"
try_candidate "$(unit_exec_start)" "systemd ExecStart for $PROMOTE_UNIT"
CROSS="$XPFD"

if [ -n "$CROSS" ] && ! same_file "$CROSS" "$RECORDED"; then
    refuse "the arming recorded $RECORDED as the xpfd that must verify this" \
        "candidate, but $PROMOTE_UNIT independently resolves to $CROSS" \
        "($XPFD_SRC), and those are DIFFERENT FILES (not merely different" \
        "names for one). That is exactly what a stale leftover unit looks" \
        "like: a prior cut can leave a disabled-but-loaded unit whose drop-in" \
        "still names an OLD version, and retention keeps that version" \
        "executable. Refusing rather than picking a side."
fi

XPFD="$RECORDED"
if [ -n "$CROSS" ]; then
    XPFD_SRC="arm record, confirmed by $PROMOTE_UNIT"
else
    XPFD_SRC="arm record ($PROMOTE_UNIT resolved nothing to cross-check against)"
fi

log "promotion gate: using $XPFD ($XPFD_SRC)"

"$XPFD" upgrade kernel promote
gate_result $?
