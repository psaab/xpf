#!/usr/bin/env bash
# xpf day-0 config-drive loader (#1879 Path C).
#
# vSRX parity: Juniper vSRX on KVM accepts a bootstrap Junos config on
# an attached CD-ROM ISO carrying juniper.conf at the volume root,
# applied at first boot while the system is factory-default. This is
# the xpf analog, run as a oneshot systemd unit ordered Before=xpfd:
#
#   1. If the system has ever been configured (stamp file, a COMMITTED
#      configstore DB — active.json, written only on commit/sync — or a
#      preseeded /etc/xpf/xpf.conf), do nothing. A day-0 config is
#      applied at most once; later boots never re-apply or clobber.
#      The guard tests active.json, NOT the bare .configdb directory:
#      xpfd creates that directory on EVERY start (NewDB ->
#      MkdirAllDurable, before any commit), so its mere existence is not
#      a "configured" signal. Guarding on the bare directory silently
#      defeated the fix-and-reboot retry contract (see Retriability
#      below): after the first boot the empty .configdb existed, so a
#      rejected/absent drive could never be retried.
#   2. Probe attached block devices for a config medium: any volume
#      labeled `xpf-config` (any filesystem type), plus any ISO9660
#      medium (the vSRX cdrom convention). The medium must carry
#      xpf.conf — or juniper.conf as the vSRX-parity alias — at its
#      root. `node-id` is optional for standalone configs; an HA cluster
#      config requires an explicit `0` or `1`, enforced by check-config.
#   3. Validate with the REAL commit-check gate (`xpfd check-config`,
#      configstore.CheckText: strict parse + #1319 SchemaValidate +
#      strict compile). Only a config that a real commit would accept
#      is installed as /etc/xpf/xpf.conf; xpfd's normal
#      bootstrap-from-file path then imports and commits it.
#   4. Any failure — no medium, no config file, validation reject,
#      mount error — logs loudly and falls back to the factory
#      bootstrap (xpfd brings up fxp0 via DHCP). This script NEVER
#      blocks or fails the boot: it always exits 0, and the unit is
#      ordering-only (Before=, no Requires=) with a start timeout.
#
# Security posture: the config drive is UNTRUSTED operator input. It is
# mounted ro,nosuid,nodev,noexec; only two fixed filenames at the volume
# root are considered, each opened ONCE with O_NOFOLLOW and fstat-checked on
# the fd (a symlink/fifo/swap fails the read, never the guard — #9921 F-147);
# the config is size-capped (here and again inside `xpfd check-config`);
# node-id must be literally `0` or `1`; medium reads and validation run under
# timeouts. Nothing on the medium is ever executed.
#
# Retriability: a medium that fails validation does NOT write the stamp,
# so the operator can fix the config and reboot — the system is still
# unconfigured, so this is safe and matches the "first boot of a
# factory-default system" semantic rather than literally "first boot".

set -u

XPF_DIR=/etc/xpf
STAMP="$XPF_DIR/.day0-config-applied"
MNT=/run/xpf-day0
XPFD=/usr/local/sbin/xpfd
MAX_CONF_BYTES=$((4 * 1024 * 1024)) # keep in sync with xpfd check-config
CHECK_TIMEOUT=60

log()  { echo "xpf-day0: $*"; }
warn() { echo "xpf-day0: WARNING: $*" >&2; }

# safe_read_medium <path> <cap> — read a medium file onto stdout with
# O_NOFOLLOW + an fstat type check on the SAME fd (#9921 F-147). The old
# `[ -f ] && [ ! -L ]` guard and the `head -c` read were separate syscalls
# against a medium whose backing store the hypervisor can mutate, so a
# mid-probe swap defeated the guard: a symlink redirected the read to a
# host-side path and a fifo stalled the copy. Opening once with O_NOFOLLOW
# and fstat()ing the fd (not the path) closes both: a symlink fails the open
# with ELOOP, and anything not a regular file (fifo, dir, socket) fails the
# fstat check — before a single byte is read. Output is capped at <cap> bytes
# (callers pass max+1 to detect oversize) and the whole read runs under a
# small timeout as a backstop against a wedged backing device.
# Exit: 0 ok / 10 ENOENT / 11 ELOOP (symlink) / 12 non-regular /
# 13 read error / 14 perl missing / 124 timeout. Missing perl fails CLOSED
# (skip the device, never fail the boot): there is deliberately no `head`
# fallback, which would preserve the hole. perl-base (with Fcntl) is
# Essential on the Ubuntu base and pinned in RUNTIME_PACKAGES + the
# xpf-appliance Depends, so absence means a broken system, not a regression.
safe_read_medium() {
	if [ $# -ne 2 ]; then
		echo "xpf-day0: WARNING: safe_read_medium called without <path> <cap>" >&2
		return 13
	fi
	command -v perl >/dev/null 2>&1 || return 14
	timeout 10 perl -e '
use strict;
use warnings;
use Fcntl qw(O_RDONLY O_NOFOLLOW O_NONBLOCK);
my ($p, $cap) = @ARGV;
my $fh;
if (!sysopen($fh, $p, O_RDONLY | O_NOFOLLOW | O_NONBLOCK)) {
	if ($!{ENOENT}) { exit 10; }
	if ($!{ELOOP}) { exit 11; }
	exit 13;
}
if (!-f $fh) { exit 12; }
binmode($fh);
binmode(STDOUT);
my $n = 0;
while ($n < $cap) {
	my $want = $cap - $n;
	$want = 65536 if $want > 65536;
	my $r = sysread($fh, my $chunk, $want);
	if (!defined $r) { exit 13; }
	last if $r == 0;
	print $chunk;
	$n += $r;
}
' -- "$1" "$2"
}

cleanup() {
	umount "$MNT" 2>/dev/null || true
	rmdir "$MNT" 2>/dev/null || true
}
trap cleanup EXIT

# The sealed image ships without ssh host keys (virt-sysprep); first
# boot regenerates them. This unit is Before=ssh.service so sshd starts
# with fresh, per-instance keys.
regen_ssh_host_keys() {
	if ! ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1; then
		log "regenerating ssh host keys (sealed-image first boot)"
		ssh-keygen -A >/dev/null 2>&1 || warn "ssh-keygen -A failed"
	fi
}

# Candidate devices: labeled volumes first (explicit operator intent),
# then any ISO9660 medium (vSRX cdrom parity). blkid is run under
# timeout: a faulty/hung virtual medium must not consume the unit's
# TimeoutStartSec and delay xpfd/sshd by the full backstop.
#
# The dedup MUST NOT reorder (#6502). `| sort -u` alphabetized the merged
# list, so an ISO whose /dev node sorts earlier than the labeled volume's
# was probed FIRST — an ISO at /dev/sda ahead of a labeled volume at
# /dev/sdb, or any /dev/sd* ISO ahead of a virtio-blk /dev/vd* volume.
# Kernel enumeration order is not operator intent (incus attaches both as
# virtio-scsi sd* in attach order), so with two valid-but-different media
# attached the ISO won and stamped — the exact opposite of the rule this
# comment states. The self-correcting case still converged, because a
# REJECT does not stamp; the wrong-winner case is both-valid-different.
#
# `awk 'NF && !seen[$0]++'` over the CONCATENATED stream keeps
# first-appearance order, so pass 1 (labeled) is exhausted before pass 2
# (ISO) contributes anything. It also dedups ACROSS the passes, which a
# per-pass dedup would not: a medium that is BOTH labeled and iso9660
# appears exactly once, in its LABELED position, so explicit intent still
# wins for that device. NF drops blank lines from the raw output — hygiene,
# not a behaviour change: `devs=$(probe_devices)` strips trailing newlines
# and `for dev in $devs` word-splits, so a blank line could never have become
# a probed device. It keeps the function's own output honest for anything
# that reads it directly.
probe_devices() {
	{
		timeout 15 blkid -o device -t LABEL=xpf-config 2>/dev/null || true
		timeout 15 blkid -o device -t TYPE=iso9660 2>/dev/null || true
	} | awk 'NF && !seen[$0]++'
}

# try_device <dev> — returns 0 if a config was validated and installed.
try_device() {
	local dev="$1" conf="" nodeid="" nodearg=() out rc tmpconf="" nodeid_raw=""
	log "probing config medium $dev"
	mkdir -p "$MNT"
	# timeout: a hung backing device (e.g. a host-side network share
	# behind a virtual cdrom) must not stall the boot path.
	if ! timeout 20 mount -o ro,nosuid,nodev,noexec "$dev" "$MNT" 2>/dev/null; then
		warn "cannot mount $dev read-only — skipping"
		return 1
	fi

	# Copy ONCE per candidate through the O_NOFOLLOW helper into a private
	# root-only temp file, then size-check, validate, and install that same
	# copy: a mutable backing store (hypervisor-side swap of an attached
	# disk) must not be able to change the bytes between validation and
	# install. There is deliberately no -f/! -L pre-check: it was the racy
	# half of the old check-then-read (#9921 F-147). mktemp runs AFTER a
	# good mount: every return below this point removes the temp file.
	tmpconf=$(mktemp /run/xpf-day0-conf.XXXXXX) || {
		warn "mktemp failed — skipping $dev"
		umount "$MNT"
		return 1
	}
	local f
	for f in xpf.conf juniper.conf; do
		# rc capture WITHOUT `!` (`if !` would negate $?): ENOENT(10)
		# tries the alias silently; any other failure warns and tries it.
		safe_read_medium "$MNT/$f" "$((MAX_CONF_BYTES + 1))" >"$tmpconf" 2>/dev/null
		rc=$?
		if [ "$rc" -eq 0 ]; then
			conf="$MNT/$f"
			break
		fi
		if [ "$rc" -ne 10 ]; then
			warn "$MNT/$f could not be safely read (rc=$rc) — trying next"
		fi
	done
	if [ -z "$conf" ]; then
		log "$dev carries no readable xpf.conf/juniper.conf at its root — skipping"
		rm -f "$tmpconf"
		umount "$MNT"
		return 1
	fi
	local size
	size=$(stat -c %s "$tmpconf" 2>/dev/null || echo 0)
	if [ "$size" -le 0 ] || [ "$size" -gt "$MAX_CONF_BYTES" ]; then
		warn "$conf size $size out of bounds (1..$MAX_CONF_BYTES) — skipping $dev"
		rm -f "$tmpconf"
		umount "$MNT"
		return 1
	fi

	# node-id is optional for standalone configs; strict check-config rejects
	# HA cluster configs unless this input resolves to 0 or 1. Two-step rc
	# capture — no pipefail in this script, so piping the helper into tr would
	# report tr's status and conflate every failure mode.
	nodeid_raw=""
	rc=0
	nodeid_raw=$(safe_read_medium "$MNT/node-id" 16 2>/dev/null) || rc=$?
	if [ "$rc" -eq 0 ]; then
		nodeid=$(printf '%s' "$nodeid_raw" | tr -d '[:space:]')
		if [ "$nodeid" != "0" ] && [ "$nodeid" != "1" ]; then
			warn "node-id on $dev is not 0 or 1 (got '$nodeid') — ignoring node-id"
			nodeid=""
		else
			nodearg=(-node-id "$nodeid")
		fi
	elif [ "$rc" -ne 10 ]; then
		warn "node-id on $dev could not be safely read (rc=$rc) — ignoring node-id"
	fi

	log "validating $(basename "$conf") from $dev with the strict commit-check gate"
	out=$(timeout "$CHECK_TIMEOUT" "$XPFD" check-config "${nodearg[@]}" "$tmpconf" 2>&1)
	rc=$?
	if [ $rc -ne 0 ]; then
		case $rc in
		2) warn "day-0 config on $dev REJECTED by commit-check — NOT installing; falling back to factory bootstrap (fxp0 DHCP)" ;;
		124) warn "day-0 config validation timed out after ${CHECK_TIMEOUT}s — NOT installing" ;;
		*) warn "day-0 config validation failed (exit $rc) — NOT installing" ;;
		esac
		while IFS= read -r line; do warn "  $line"; done <<<"$out"
		rm -f "$tmpconf"
		umount "$MNT"
		return 1
	fi

	mkdir -p "$XPF_DIR"
	chmod 0750 "$XPF_DIR" 2>/dev/null || true
	# 0600: a day-0 config may carry credential material
	# (root-authentication encrypted-password, IKE PSKs). Install the
	# validated COPY, never re-read the medium.
	if ! install -o root -g root -m 0600 "$tmpconf" "$XPF_DIR/xpf.conf"; then
		warn "failed to install $XPF_DIR/xpf.conf"
		rm -f "$tmpconf"
		umount "$MNT"
		return 1
	fi
	rm -f "$tmpconf"
	# Persist node-id BEFORE stamping success: the config was commit-checked
	# with -node-id and xpfd reads /etc/xpf/node-id before bootstrap. If this
	# tiny write fails we must NOT stamp — a config validated as node 1 could
	# otherwise boot with standalone/node-0 expansion while the stamp claims
	# success. Return non-zero so the next boot retries (install is
	# idempotent; the stamp gates retry).
	if [ -n "$nodeid" ]; then
		if ! printf '%s\n' "$nodeid" >"$XPF_DIR/node-id"; then
			warn "failed to persist node-id $nodeid — not stamping; will retry on reboot"
			rm -f "$XPF_DIR/xpf.conf"
			umount "$MNT"
			return 1
		fi
		log "installed node-id $nodeid"
	fi
	printf 'applied %s from %s at %s\n' "$(basename "$conf")" "$dev" \
		"$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$STAMP"
	log "day-0 config installed as $XPF_DIR/xpf.conf — xpfd will import and commit it at startup"
	umount "$MNT"
	return 0
}

# have_committed_config — true (0) when the box already holds a COMMITTED
# configstore DB, i.e. .configdb/active.json exists. active.json is written
# only by a successful commit / HA sync / rollback (pkg/configstore/db.go
# WriteActive*); the bare .configdb DIRECTORY is created on EVERY xpfd start
# by NewDB -> MkdirAllDurable (before any commit), so its existence is NOT a
# "configured" signal. Testing active.json — not the directory — is what
# makes the fix-and-reboot retry contract work: a rejected/absent drive
# leaves the box in factory bootstrap with no active.json, so the loader
# re-probes on the next boot instead of falsely declaring "already
# configured" forever.
have_committed_config() {
	[ -e "$XPF_DIR/.configdb/active.json" ]
}

main() {
	regen_ssh_host_keys

	if [ -e "$STAMP" ]; then
		log "day-0 config already applied ($STAMP) — skipping"
		return 0
	fi
	if have_committed_config; then
		log "committed config present ($XPF_DIR/.configdb/active.json) — system already configured, skipping day-0 probe"
		return 0
	fi
	if [ -e "$XPF_DIR/xpf.conf" ]; then
		log "preseeded $XPF_DIR/xpf.conf exists — skipping day-0 probe"
		return 0
	fi
	if [ ! -x "$XPFD" ]; then
		warn "$XPFD not found — cannot validate a day-0 config, skipping probe"
		return 0
	fi

	local devs dev tries
	for tries in 1 2; do
		devs=$(probe_devices)
		[ -n "$devs" ] && break
		# Give udev a moment on first boot — a cdrom attached at power-on
		# can enumerate a beat after local-fs.target.
		[ "$tries" -eq 1 ] && sleep 2
	done

	if [ -z "${devs:-}" ]; then
		log "no config medium found — factory bootstrap (fxp0 DHCP) will run"
		return 0
	fi

	for dev in $devs; do
		if try_device "$dev"; then
			return 0
		fi
	done

	log "no usable day-0 config found — factory bootstrap (fxp0 DHCP) will run"
	return 0
}

# Run main unless the file is sourced for unit tests. A test sets
# XPF_DAY0_SOURCE_ONLY=1 and sources this script to exercise the individual
# helpers (e.g. have_committed_config, main with stubbed probes) without
# actually running the day-0 loader.
if [ "${XPF_DAY0_SOURCE_ONLY:-}" != "1" ]; then
	main "$@"
	exit 0
fi
