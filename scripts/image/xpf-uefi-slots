#!/bin/sh
# xpf (#1930) — register the two FIXED A/B UEFI boot slots (xpf-A / xpf-B).
#
# This is the SEPARATE, NON-BLOCKING slot-registration step the LANE-1 kernel
# channel needs (r4 AGY F2 / r5 AGY c). Rationale:
#   - UEFI Boot#### vars live in the target's firmware NVRAM, which the OFFLINE
#     bake (virt-customize) cannot write — registration MUST happen in-guest on
#     real hardware (r4 AGY F2).
#   - It is NOT folded into xpf-day0-config: that unit is Before=xpfd and exits
#     early once /etc/xpf/.configdb exists, so a SAFE-BOOTSTRAP node (configured
#     via the lifeline, no day-0 media) would NEVER get its slots registered;
#     and a hanging efibootmgr Before=xpfd would block the lifeline = brick
#     (r5 AGY c).
#   - So this is its own oneshot, shipped in the .deb (foreign-host installs get
#     it too), NOT ordered Before=xpfd, with a bounded timeout and non-fatal
#     error handling: read-only / no-efivars platforms log a warning, leave LANE
#     1 unavailable, and the box boots normally (degraded, not bricked).
#
# IDEMPOTENT + self-healing (r5 SMR N3): every boot it verifies the two slots
# exist with the right loader path and the active slot is reachable in BootOrder,
# (re)creating ONLY what is missing — a firmware reset / VM redefinition that
# wiped NVRAM self-heals, and repeated boots never duplicate slots.
#
# It seeds xpf-A first only when neither slot is yet in BootOrder (fresh box).
# Once either slot is present, it preserves the current front — including an
# operator-selected non-xpf entry — instead of mistaking it for a fresh box,
# UNLESS the front is the distributor (ubuntu/shim) entry and the recorded
# front says xpf last wrote a slot front: that is a bootloader postinst's
# NVRAM rewrite (#16449), not an operator choice, so the recorded slot front
# is re-asserted. See the recorded-front block below.

set -u

# --- A/B slot loader refresh (#15089, A57-01) ---
# The bake copied shim/grub/mm from EFI/ubuntu into EFI/xpf-A and
# EFI/xpf-B exactly once. Ubuntu's shim-signed / grub-efi-amd64-signed
# updates install only to EFI/ubuntu, while BootOrder keeps booting the
# xpf slots, so without a refresh the Secure-Boot chain stays on the
# bake-time bootloader for the life of the appliance (a SBAT/dbx
# revocation would never reach the booted loader). sync_ab_slots()
# re-copies the loaders atomically on every boot and, via the dpkg file
# trigger in debian/xpf.triggers, immediately after a bootloader
# package update (postinst `triggered` -> this script --sync-only).
#
# Atomicity: each loader is written to a temp file in the SAME slot dir
# and renamed over the live name, so a power cut mid-copy can never
# leave a truncated loader at the booted path. cmp-gated: an in-sync
# slot is not rewritten (no needless ESP writes / flash wear).
# Fail-closed per file: a source loader that exists MUST land in both
# slots; a copy failure returns non-zero so the caller can log it.
# `mmx64.efi` obeys the same rule when EFI/ubuntu ships it; when the
# source has no mm (the bake's fallback shape) absence in the slots is
# left as-is rather than treated as drift. xpf.selector is slot state,
# never loader state, and is never touched here.
LOADER_FILES="shimx64.efi grubx64.efi mmx64.efi"

sync_one_loader() {
    _src="$1"; _dst="$2"
    cmp -s "$_src" "$_dst" 2>/dev/null && return 0
    _tmp="${_dst}.tmp-$$"
    rm -f "$_tmp"
    cp -f "$_src" "$_tmp" || { rm -f "$_tmp"; return 1; }
    sync -f "$_tmp" 2>/dev/null || true
    mv -f "$_tmp" "$_dst" || { rm -f "$_tmp"; return 1; }
    sync -f "$_dst" 2>/dev/null || true
    cmp -s "$_src" "$_dst" 2>/dev/null || return 1
    return 0
}

sync_ab_slots() {
    _src_dir="$ESP_ROOT/EFI/ubuntu"
    [ -d "$_src_dir" ] || return 0
    _rc=0
    for _slot in xpf-A xpf-B; do
        _dst_dir="$ESP_ROOT/EFI/$_slot"
        [ -d "$_dst_dir" ] || continue
        for _f in $LOADER_FILES; do
            _src="$_src_dir/$_f"
            [ -f "$_src" ] || continue
            if ! sync_one_loader "$_src" "$_dst_dir/$_f"; then
                log "WARNING: failed to refresh $_slot/$_f from EFI/ubuntu"
                _rc=1
            fi
        done
        sync -f "$_dst_dir" 2>/dev/null || true
    done
    return $_rc
}

# Force the C locale so efibootmgr's "BootOrder:" / "BootCurrent:" / "BootXXXX*"
# headings are never localized — a translated heading would break every parse
# below and could (pre-guard) wipe BootOrder (r1 AGY: locale-robust parsing).
export LC_ALL=C LANG=C

log() { echo "xpf-uefi-slots: $*" >&2; }

# The efivars directory, ESP mountpoint, and block-device check root are
# overridable for the self-test (scripts/image/test_uefi_slots_6499.py) only;
# in production they are the real kernel/ESP paths. This script MUTATES
# firmware NVRAM and can delete boot entries, so its destructive paths need
# hermetic coverage — and they cannot be reached at all without pointing these
# roots at a synthetic tree (same pattern as xpf-grow-root's XPF_GROW_ROOT_SYSFS
# / XPF_GROW_ROOT_STAMP). Everything else — efibootmgr, findmnt, lsblk — is
# resolved from PATH, which the self-test shadows with mocks. The `-b` sanity
# check below is NOT relaxed: the self-test maps the resolved disk name to a
# REAL host block device so the check is exercised rather than bypassed.

# Only the validation root is overridable: efibootmgr must always receive the
# real /dev path in production (and the matching path in the test).
ESP_DEV_ROOT="${XPF_UEFI_SLOTS_DEV_ROOT:-/dev}"
# The UEFI LOADER path (\EFI\<slot>\shimx64.efi) is deliberately NOT derived
# from these: it is a firmware path interpreted by the firmware, not a mount.
EFIVARS_DIR="${XPF_UEFI_SLOTS_EFIVARS:-/sys/firmware/efi/efivars}"
ESP_ROOT="${XPF_UEFI_SLOTS_ESP:-/boot/efi}"
# Recorded BootOrder front (#16449). On every run that itself writes or
# confirms the BootOrder front, the script records WHICH front it left,
# under /var/lib/xpf (created by the .deb, shipped in the baked image) —
# never on the ESP, whose EFI/ubuntu tree is the distributor's. Format:
#   front=<Boot#### id or empty>
#   slot=<xpf-A|xpf-B|empty>   (set iff front is an xpf slot this run knows)
#   order=<full BootOrder at record time>
# Missing/unreadable/garbled file = no recorded front: the operator-choice
# preservation below then applies exactly as before (never a takeover on
# missing state). Overridable for the self-test only.
STATE_DIR="${XPF_UEFI_SLOTS_STATE_DIR:-/var/lib/xpf}"
STATE_FILE="${XPF_UEFI_SLOTS_STATE:-$STATE_DIR/uefi-bootorder-front}"

# is_distributor_entry <Boot#### id> : true iff that entry's loader is the
# distributor shim path \EFI\ubuntu\shimx64.efi (case-insensitive, matching
# efibootmgr's rendering). This is the entry grub-efi-amd64-signed /
# shim-signed (re)creates and prepends via grub-install with NVRAM writes.
is_distributor_entry() {
    _line=$(efibootmgr | grep -E "^Boot$1\*?[[:space:]]" 2>/dev/null | head -1)
    [ -n "$_line" ] || return 1
    echo "$_line" | grep -qiE 'EFI[\\/]ubuntu[\\/]shimx64\.efi'
}

# record_front <front-id> <slot-label-or-empty> <order>
# Best-effort durable write (temp + rename + dir sync). A failure only
# loses the #16449 recovery for one cycle; registration itself must not
# fail the boot over state bookkeeping.
record_front() {
    _rf_front="$1"; _rf_slot="$2"; _rf_order="$3"
    [ -n "$_rf_front" ] || return 0
    mkdir -p "$STATE_DIR" 2>/dev/null || { log "WARNING: cannot create $STATE_DIR; recorded front not saved"; return 0; }
    _rf_tmp="${STATE_FILE}.tmp-$$"
    if { printf 'front=%s\nslot=%s\norder=%s\n' "$_rf_front" "$_rf_slot" "$_rf_order" > "$_rf_tmp" && sync -f "$_rf_tmp" 2>/dev/null; }; then
        mv -f "$_rf_tmp" "$STATE_FILE" 2>/dev/null || { rm -f "$_rf_tmp"; log "WARNING: cannot install recorded front $STATE_FILE"; return 0; }
        sync -f "$STATE_DIR" 2>/dev/null || true
    else
        rm -f "$_rf_tmp" 2>/dev/null || true
        log "WARNING: cannot write recorded front $STATE_FILE"
    fi
    return 0
}

# read_recorded_front : sets REC_FRONT / REC_SLOT, or empties.
read_recorded_front() {
    REC_FRONT=""; REC_SLOT=""
    [ -f "$STATE_FILE" ] || return 0
    REC_FRONT=$(sed -nE 's/^front=([0-9A-Fa-f]{4})$/\1/p' "$STATE_FILE" 2>/dev/null | head -1)
    REC_SLOT=$(sed -nE 's/^slot=(xpf-A|xpf-B)$/\1/p' "$STATE_FILE" 2>/dev/null | head -1)
    # A recorded slot implies a recorded slot front; inconsistency = garbled.
    [ -n "$REC_SLOT" ] && [ -z "$REC_FRONT" ] && REC_SLOT=""
    return 0
}

# --sync-only: refresh the slot loaders from EFI/ubuntu and exit. Used
# by the dpkg file trigger (debian/xpf.triggers -> xpf.postinst
# `triggered`) so a shim/grub package update lands in both slots
# immediately, without waiting for a reboot. Deliberately independent
# of the NVRAM capability gate below: syncing files on the ESP must
# not require readable firmware variables. ESP_ROOT is already set
# (production /boot/efi; the env override exists for the hermetic
# self-test), and the sync itself is a no-op when EFI/ubuntu is absent.
if [ "${1:-}" = "--sync-only" ]; then
    if sync_ab_slots; then
        exit 0
    fi
    log "WARNING: A/B slot loader refresh incomplete (non-fatal; next boot retries)"
    exit 0
fi

# --- capability gate: UEFI + efibootmgr + writable efivars (all non-fatal) ---
if [ ! -d "$EFIVARS_DIR" ]; then
    log "not a UEFI boot (no efivars); LANE-1 kernel channel unavailable — skipping"
    exit 0
fi
if ! command -v efibootmgr >/dev/null 2>&1; then
    log "efibootmgr not installed; skipping (LANE-1 unavailable)"
    exit 0
fi
if ! efibootmgr >/dev/null 2>&1; then
    log "efibootmgr cannot read NVRAM (read-only firmware?); skipping (LANE-1 unavailable)"
    exit 0
fi

# --- discover the ESP block device + partition for --disk/--part ---
ESP_SRC=$(findmnt -no SOURCE "$ESP_ROOT" 2>/dev/null || true)
if [ -z "$ESP_SRC" ]; then
    log "no ESP mounted at $ESP_ROOT; skipping"
    exit 0
fi
# Resolve the partition number and its parent disk independently of device
# naming conventions (for example, /dev/sdap1 belongs to /dev/sdap, not
# /dev/sda). lsblk's PARTN and PKNAME are authoritative for the mounted source.
ESP_DISK_NAME=$(lsblk -no PKNAME "$ESP_SRC" 2>/dev/null | head -n1)
ESP_PART=$(lsblk -no PARTN "$ESP_SRC" 2>/dev/null | head -n1)
ESP_DISK="/dev/$ESP_DISK_NAME"
if [ -z "$ESP_PART" ] || [ -z "$ESP_DISK_NAME" ] || \
        [ ! -b "$ESP_DEV_ROOT/$ESP_DISK_NAME" ]; then
    log "could not parse ESP disk/part from '$ESP_SRC'; skipping"
    exit 0
fi

# The signed shim is the loader for BOTH slots (shim->grub->MOK kernel). Each
# slot's EFI dir holds its own shim+grub copy (staged by the bake / INC-1); the
# loader path is \EFI\<slot>\shimx64.efi.
register_slot() {
    slot="$1"
    # already registered? An efibootmgr line is:
    #   Boot0003* xpf-A\tHD(1,GPT,...)/\EFI\xpf-A\shimx64.efi
    # i.e. "BootXXXX*<sp>LABEL<TAB>loader-path" — the LABEL is followed by a TAB
    # + the loader path, NOT line-end. So the guard must match the label
    # bounded by the trailing TAB/space, NOT anchored at $ (that miss created
    # duplicate slots — caught live, #1930).
    # Verify BOTH the label AND the loader path: an entry that merely shares
    # the label but points elsewhere (e.g. a stale/foreign entry) must NOT be
    # accepted, or the slot would chainload the wrong loader (r1 Codex High).
    # efibootmgr prints the loader as "...File(\EFI\<slot>\shimx64.efi)" or
    # "...\EFI\<slot>\shimx64.efi"; match the slot's shim path case-insensitively.
    # Enumerate ALL entries with this label. Delete every WRONG-path one
    # unconditionally (a stale/foreign label-collision would poison BootNext —
    # r2 Codex High), and dedup any CORRECT ones down to exactly one. This
    # guarantees the slot maps to a single, correct Boot#### id afterwards.
    correct_kept=""
    for n in $(efibootmgr | sed -nE "s/^Boot([0-9A-Fa-f]{4})\*?[[:space:]]+${slot}[[:space:]].*/\\1/p"); do
        line=$(efibootmgr | grep -E "^Boot${n}\*?[[:space:]]+${slot}[[:space:]]")
        if echo "$line" | grep -qiE "EFI.${slot}.shimx64\.efi"; then
            if [ -z "$correct_kept" ]; then
                correct_kept="$n"   # keep the first correct one
            else
                log "slot ${slot}: deleting duplicate correct entry Boot${n}"
                efibootmgr --quiet -b "$n" -B 2>/dev/null || true
            fi
        else
            log "slot ${slot}: deleting WRONG-path entry Boot${n} ($line)"
            efibootmgr --quiet -b "$n" -B 2>/dev/null || true
        fi
    done
    if [ -n "$correct_kept" ]; then
        log "slot ${slot} already registered (loader path verified, deduped to Boot${correct_kept})"
        return 0
    fi
    # the slot's ESP dir must exist (bake/INC-1 staged shim+grub there)
    if [ ! -f "$ESP_ROOT/EFI/${slot}/shimx64.efi" ]; then
        log "slot ${slot} ESP dir not staged (no shimx64.efi); skipping ${slot}"
        return 1
    fi
    log "registering slot ${slot} -> \\EFI\\${slot}\\shimx64.efi"
    if ! efibootmgr --quiet --create \
            --disk "$ESP_DISK" --part "$ESP_PART" \
            --label "$slot" \
            --loader "\\EFI\\${slot}\\shimx64.efi" 2>/dev/null; then
        log "WARNING: failed to register slot ${slot} (non-fatal)"
        return 1
    fi
    return 0
}

# Capture BootOrder and its lead before registration: efibootmgr --create
# prepends new entries and could otherwise steal an operator-selected default.
# If an xpf slot already led, that is the PROMOTED default and MUST be preserved
# even if the other slot is missing. If an xpf slot was present later in the
# order, preserve the non-xpf entry that the operator chose to lead it. Only
# when neither xpf slot was in BootOrder do we seed a deterministic default.
slot_id() { efibootmgr | sed -nE "s/^Boot([0-9A-Fa-f]{4})\*?[[:space:]]+$1[[:space:]].*/\\1/p" | head -1; }
PRE_ORDER=$(efibootmgr | sed -nE 's/^BootOrder: (.*)$/\1/p')
PRE_FRONT=${PRE_ORDER%%,*}
PRE_A=$(slot_id xpf-A)
PRE_B=$(slot_id xpf-B)
LED_SLOT=""   # which xpf slot label led before this run, if any
[ -n "$PRE_A" ] && [ "$PRE_FRONT" = "$PRE_A" ] && LED_SLOT=xpf-A
[ -n "$PRE_B" ] && [ "$PRE_FRONT" = "$PRE_B" ] && LED_SLOT=xpf-B
PRE_HAS_XPF=""
for pre_id in "$PRE_A" "$PRE_B"; do
    [ -n "$pre_id" ] || continue
    case ",$PRE_ORDER," in
        *,"$pre_id",*) PRE_HAS_XPF=1 ;;
    esac
done

# Refresh stale slot loaders BEFORE registration verifies them (#15089):
# a slot whose shim was just updated on disk must be the loader NVRAM
# (re)registration points at. Non-fatal on failure — registration and
# boot proceed on the existing copies ("degraded, not bricked").
sync_ab_slots || log "WARNING: A/B slot loader refresh incomplete (non-fatal; continuing to registration)"

register_slot xpf-A || true
register_slot xpf-B || true

# --- normalize BootOrder ---
A_ID=$(slot_id xpf-A)
B_ID=$(slot_id xpf-B)
ORDER=$(efibootmgr | sed -nE 's/^BootOrder: (.*)$/\1/p')

# GUARD: if BootOrder could not be parsed (empty — a transient efibootmgr read
# failure, or an unexpected format), DO NOT write a BootOrder — a reseed built
# from empty $ORDER would WIPE all other entries (PXE/recovery/firmware), the
# opposite of non-destructive (r1 AGY destructive-wipe). Leave NVRAM untouched.
if [ -z "$ORDER" ]; then
    log "WARNING: could not read BootOrder; leaving it unchanged (no destructive reseed)"
elif [ -n "$LED_SLOT" ]; then
    # An xpf slot was the promoted default before this run — keep THAT slot in
    # front (re-assert in case a --create reshuffled BootOrder), preserving the
    # rest non-destructively. NEVER force A-first over a promoted B.
    LEAD_ID=$(slot_id "$LED_SLOT")
    if [ -n "$LEAD_ID" ]; then
        REST=$(echo "$ORDER" | tr ',' '\n' | grep -vxF "$LEAD_ID" | paste -sd, -)
        NEW="$LEAD_ID"
        [ -n "$REST" ] && NEW="$NEW,$REST"
        if [ "$NEW" != "$ORDER" ]; then
            log "preserving promoted slot $LED_SLOT as default: $NEW (was: $ORDER)"
            if efibootmgr --quiet --bootorder "$NEW" 2>/dev/null; then
                ORDER="$NEW"
            else
                log "WARNING: failed to re-assert promoted default (non-fatal)"
            fi
        else
            log "promoted slot $LED_SLOT already leads BootOrder; preserving"
        fi
        record_front "$LEAD_ID" "$LED_SLOT" "$ORDER"
    fi
elif [ -n "$PRE_HAS_XPF" ] && [ -n "$PRE_FRONT" ] && \
        is_distributor_entry "$PRE_FRONT"; then
    # (#16449) PRE_FRONT is the distributor (ubuntu/shim) entry while an
    # xpf slot is still in BootOrder. Two writers can put it there:
    #   (a) grub-efi-amd64-signed / shim-signed postinst: grub-install
    #       with NVRAM writes (grub2/update_nvram=true) (re)creates the
    #       Ubuntu entry and prepends it — routine -security traffic;
    #   (b) an operator who deliberately ran `efibootmgr --bootorder`
    #       to lead with the stock Ubuntu entry.
    # They are distinguishable ONLY by the recorded front: if xpf last
    # recorded a SLOT front and the current front is now the distributor
    # entry, case (a) rewrote it after xpf's last write, so re-assert
    # the recorded slot (falling back to whichever slot leads the rest
    # of the current order, then A). If there is no recorded slot front
    # — fresh state, an operator front recorded earlier, or the
    # distributor entry recorded as the front — this is (b) or unknown:
    # preserve the front exactly as the operator-choice arm below does.
    # NEVER take over on missing state (no fail-open of the gate).
    read_recorded_front
    TAKEOVER_ID=""
    TAKEOVER_SLOT=""
    if [ -n "$REC_SLOT" ]; then
        TAKEOVER_SLOT="$REC_SLOT"
        TAKEOVER_ID=$(slot_id "$REC_SLOT")
        [ -n "$TAKEOVER_ID" ] || TAKEOVER_ID="$REC_FRONT"
        # The recorded id must still BE that slot (an entry can be
        # deleted and its id reused by firmware); otherwise resolve
        # the slot label fresh and trust only that.
        case "$TAKEOVER_ID" in
            "$A_ID"|"$B_ID") ;;
            *) TAKEOVER_ID="" ;;
        esac
        if [ -z "$TAKEOVER_ID" ]; then
            case "$REC_SLOT" in
                xpf-A) TAKEOVER_ID="$A_ID" ;;
                xpf-B) TAKEOVER_ID="$B_ID" ;;
            esac
        fi
    fi
    if [ -n "$TAKEOVER_ID" ]; then
        REST=$(echo "$ORDER" | tr ',' '\n' | grep -vxF "$TAKEOVER_ID" | paste -sd, -)
        NEW="$TAKEOVER_ID"
        [ -n "$REST" ] && NEW="$NEW,$REST"
        if [ "$NEW" != "$ORDER" ]; then
            log "distributor entry $PRE_FRONT leads BootOrder but recorded front was slot $TAKEOVER_SLOT ($TAKEOVER_ID) — bootloader postinst rewrote NVRAM (#16449); re-asserting recorded slot front: $NEW (was: $ORDER)"
            if efibootmgr --quiet --bootorder "$NEW" 2>/dev/null; then
                ORDER="$NEW"
            else
                log "WARNING: failed to re-assert recorded slot front (non-fatal)"
            fi
        else
            log "recorded slot $TAKEOVER_SLOT already leads BootOrder; preserving"
        fi
        record_front "$TAKEOVER_ID" "$TAKEOVER_SLOT" "$ORDER"
    else
        # No recorded slot front: preserve the distributor front as an
        # operator choice (or unknown), and record THAT so a later
        # deliberate operator front stays preserved while a later xpf
        # slot promotion is what arms the #16449 recovery.
        REST=$(echo "$ORDER" | tr ',' '\n' | grep -vxF "$PRE_FRONT" | paste -sd, -)
        NEW="$PRE_FRONT"
        [ -n "$REST" ] && NEW="$NEW,$REST"
        if [ "$NEW" != "$ORDER" ]; then
            log "preserving distributor BootOrder front $PRE_FRONT (no recorded slot front): $NEW (was: $ORDER)"
            if efibootmgr --quiet --bootorder "$NEW" 2>/dev/null; then
                ORDER="$NEW"
            else
                log "WARNING: failed to re-assert distributor default (non-fatal)"
            fi
        else
            log "distributor entry $PRE_FRONT leads BootOrder with no recorded slot front; preserving as operator choice"
        fi
        record_front "$PRE_FRONT" "" "$ORDER"
    fi
elif [ -n "$PRE_HAS_XPF" ]; then
    # A non-xpf entry was already the default while an xpf slot remained
    # reachable. Preserve that operator choice; re-assert it only if creating a
    # missing slot caused efibootmgr to prepend the new entry.
    REST=$(echo "$ORDER" | tr ',' '\n' | grep -vxF "$PRE_FRONT" | paste -sd, -)
    NEW="$PRE_FRONT"
    [ -n "$REST" ] && NEW="$NEW,$REST"
    if [ "$NEW" != "$ORDER" ]; then
        log "preserving non-xpf BootOrder front $PRE_FRONT: $NEW (was: $ORDER)"
        if efibootmgr --quiet --bootorder "$NEW" 2>/dev/null; then
            ORDER="$NEW"
        else
            log "WARNING: failed to re-assert non-xpf default (non-fatal)"
        fi
    else
        log "non-xpf entry $PRE_FRONT already leads BootOrder; preserving"
    fi
    record_front "$PRE_FRONT" "" "$ORDER"
elif [ -n "$A_ID" ]; then
    # Neither xpf slot was present in the pre-run BootOrder (fresh box) —
    # deterministic seed: xpf-A first, xpf-B second, then other entries.
    REST=$(echo "$ORDER" | tr ',' '\n' | grep -vxF "$A_ID" | grep -vxF "${B_ID:-__none__}" | paste -sd, -)
    # This remains non-destructive except for the intentional initial default.
    NEW="$A_ID"
    [ -n "$B_ID" ] && NEW="$NEW,$B_ID"
    [ -n "$REST" ] && NEW="$NEW,$REST"
    log "seeding BootOrder: $NEW (was: $ORDER)"
    if efibootmgr --quiet --bootorder "$NEW" 2>/dev/null; then
        ORDER="$NEW"
    else
        log "WARNING: failed to seed BootOrder (non-fatal)"
    fi
    record_front "$A_ID" "xpf-A" "$ORDER"
else
    log "no xpf-A slot id; leaving BootOrder unchanged"
fi

log "done"
exit 0
