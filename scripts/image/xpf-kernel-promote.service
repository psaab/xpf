[Unit]
Description=xpf #1930 — LANE-1 kernel-channel promotion gate (candidate boot)
Documentation=https://github.com/psaab/xpf/issues/1930
# Run after the dataplane/network is up enough for verify-dataplane + the
# forward beacon, but this is NOT a hard Before=xpfd dependency: a stuck gate
# must never wedge the box (the SAFE-BOOTSTRAP lifeline must still come up).
# Ordering Wants/After local-fs + network so the beacon can probe.
After=local-fs.target network-online.target xpfd.service
Wants=network-online.target
# On a HANG/timeout (or a SIGTERM kill of the gate) the script's exit-3 reboot
# path never runs, so without this the candidate would sit booted-but-held
# SECONDARY indefinitely (r2 AGY Finding 3). OnFailure reboots once to the
# known-good slot. SAFE against a bounce loop: an ordinary (known-good) boot's
# gate settles any deferred prune and exits 0, so this handler only ever fires on a candidate
# boot whose gate failed/hung — and Arm() never reordered BootOrder (it set only
# the firmware-cleared BootNext), so the reboot falls through BootOrder to
# known-good.
OnFailure=xpf-kernel-promote-failed.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Bounded: a stuck verify/beacon must not hang the boot indefinitely. On
# timeout the unit FAILS (TimeoutStartSec), triggering OnFailure (reboot to
# known-good). The script itself reboots on an explicit exit-3 (revert); an
# exit-1 infra error is treated as un-promoted without a reboot (the next plain
# reboot falls back via the firmware-cleared BootNext).
TimeoutStartSec=120
# Pin $PATH to the DISTRIBUTION directories. The gate PATH-resolves systemctl,
# readlink and reboot on purpose (they are distribution-owned, unlike xpfd), but
# systemd's default PATH ranks the operator-writable /usr/local/sbin and
# /usr/local/bin FIRST -- exactly where a stale or planted artifact would sit on
# a box whose promote-vs-rollback decision this unit authors (#6601 r4). xpfd
# itself is never PATH-resolved by either hop.
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/sbin/xpf-kernel-promote

[Install]
WantedBy=multi-user.target
