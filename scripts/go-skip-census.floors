# Floors for scripts/go-skip-census.sh (#9052 item 4).
#
# These are MEASURED values, not targets. The census reds in BOTH directions:
# an increase is a subject the suite stopped examining while still printing
# `ok`; a decrease is good news that must be banked by tightening the floor,
# because a loose floor is exactly that much room for the next regression to
# hide in.
#
# Raising a floor is allowed. Raising it SILENTLY is not — say why in the
# commit message, the same rule the Rust ignored-cell census applies to a new
# `#[ignore]`.

# #10716 banks the drift from the original 365-site measurement: 9 additional
# privilege-absent sites need kernel/network capabilities, and 15 additional
# non-privilege sites are fixture, socket, or external-input gated. Since the
# issue's 386-site recount, three further non-privilege sites were added:
# the #10702 Unix-socket availability guard and two #10641 bridge-netfilter
# availability guards. These reasons describe real skip conditions; the
# census counts them rather than claiming those cells ran.
# The 2026-09-24 master recount adds four #10708 route-reader cells gated on
# netlink handle creation, link/route reads, or a usable main-table route.
# The 2026-09-26 recount banks seven environment-gated cells merged without a
# floor update (CI runs no tests): #11191 x3 (loopback/second-interface
# availability for monitor-interface RETH tests), #11116 x2 (sshd/ssh-keygen
# binaries for factory root-login precedence), #11202 x1 (unconfigured host
# interface for monitor-traffic scope), #11156 x1 (loopback for RA goodbye
# suppression). All gate on execution-environment availability.
# The current-tree recount supersedes the 400-site measurement above: 17
# privilege-absent, 4 privilege-present, and 32 other concrete skip sites are
# now present, for 453 total including unchanged unparsed. #12119 adds one
# memlock-gated BPF_PROG_TEST_RUN regression, raising other and total by one.
# Merge composition with #12125/#12126/#12127 (measured, not banked drift):
# +2 priv-absent from #12127 dhcp_vrf_backstop netns guards, +3 priv-absent
# from #12125 manager_link_refresh netns guards, +1 other from #12126 FRR
# vtysh-absence skip. #11417's own +1/+1 floor lines are subsumed by this
# recount (same FRR-absence site).
total        = 460

# Privilege-dependent, split by DIRECTION because that split is the finding:
# no single run examines both groups. Running the suite as root does not close
# the gap, it swaps which subjects go unexamined.
priv-absent  = 71
priv-present = 14

# Everything else: environment-, tool- and fixture-gated skips.
other        = 374

# Skips this census counted but could NOT classify: `t.SkipNow()` (no message
# by construction) and non-literal messages. Deliberately a REPORTED bucket
# with its own floor rather than a silent drop — a census that quietly shrinks
# its own population is blind exactly where somebody wrote something unusual,
# and "unusual" correlates with "worth looking at".
unparsed     = 1
