[Unit]
Description=xpf Stateful Firewall Daemon
After=network-online.target frr.service
Wants=network-online.target

[Service]
Type=simple
# #16050: /run/xpf holds flock files (upgrade.lock, xpfd.lock, markers)
# an exclusive flock can be taken on via a readable O_RDONLY fd, so the
# runtime dir must not be world-traversable and the service umask must
# not let any file created under it land group/world-readable. Go code
# also asserts 0750/0600 on use; this covers shell first-creators and
# any other file the daemon or its children create under /run/xpf.
RuntimeDirectory=xpf
RuntimeDirectoryMode=0750
# #16050 fold: systemd would otherwise REMOVE /run/xpf at unit stop —
# while the upgrade runner holds an open flock on
# /run/xpf/upgrade.lock across stopping xpfd, so the path would be
# unlinked and a second process could flock a NEW inode, splitting
# the mutex mid-cutover. Preserve keeps the directory (and the lock
# path) alive across stops; it does not preserve lock semantics
# across a reboot — /run is tmpfs, the dir is recreated empty at
# boot, and flock state is per-boot by design (see pkg/upgrade/lock).
RuntimeDirectoryPreserve=yes
UMask=0027
ExecStart=/usr/local/sbin/xpfd
Restart=on-failure
RestartForceExitStatus=SIGHUP SIGPIPE
RestartSec=1
TimeoutStopSec=20
LimitMEMLOCK=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xpfd

# #712 Option A retry (after #740 fix): measured on the 6-core loss
# userspace lab with workers correctly pinned to CPUs 2-5 via
# CPUAffinity=2 3 4 5 — no metric moved by the #712 thresholds
# (rate ratio +2%, retrans +11%, per-flow CoV mean -0.6 pp, per-flow
# CoV max +1.7 pp; all within run-to-run noise). The directive is
# NOT shipped. See docs/cos-validation-notes.md §"CPU pinning retry
# post-#740" for the dated measurement, docs/712-cpu-pinning-recipe.md
# for the recipe (kept as design intent), and #739 for the kernel
# cmdline (isolcpus/nohz_full) follow-up which is now the next lever
# to try on this hardware.

[Install]
WantedBy=multi-user.target
