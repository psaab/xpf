# UDP userspace cluster on remote udp: (host 172.16.100.103). Plan: docs/incus-tcp-udp-plan.md
# Attempt 1: bridge fabric fallback (SR-IOV fabric machinery not yet implemented).
# WAN/LAN are SR-IOV VFs on mlx0/mlx1 per plan section 2.8.

INCUS_REMOTE="udp"
VM0="xpf-udp-fw0"
VM1="xpf-udp-fw1"
LAN_HOST="cluster-udp-host"
PROFILE="xpf-cluster-udp"

SRIOV_PARENT="mlx0"
SRIOV_LAN_PARENT="mlx1"
VF_LAN_VLAN=3669

NET_MGMT="incusbr-udp"
NET_HEARTBEAT="bpu-udp-hb0"
NET_FABRIC="bpu-udp-fab0"
NET_CLAN=""

CLUSTER_CONF="docs/ha-cluster-udp.conf"
# #16471/#8280: pool-mode source-NAT lever for test-failover.sh. Must agree
# with docs/ha-cluster-udp.conf's `rule pool-snat` (source 10.0.63.240/28,
# pool/proxy-ARP address 172.16.80.13); test-failover derives both from
# CLUSTER_CONF and VOIDs the pool phase instead of reporting a false
# pool/proxy-ARP defect when they disagree.
POOL_SRC="10.0.63.240"
POOL_NAT_ADDR="172.16.80.13"

LAN_ADDR="10.0.63.102/24"
LAN_GW="10.0.63.1"
LAN_HOST_IP="10.0.63.102"
LAN_VIP4="10.0.63.1"
LAN_VIP6="2001:559:8585:ba00::1"
WAN_GW4="172.16.50.1"
WAN_VIP4="172.16.50.11"
# Firewall reth gateways per VLAN (#16305): reth0.50/.80 addresses from
# docs/ha-cluster-udp.conf; wire gates use each on its own subnet.
DMZ_GW4="172.16.50.11"
WAN_GW80_4="172.16.80.11"
IPERF_TARGET4="172.16.80.211"
IPERF_TARGET6="2001:559:8585:80::211"
# VLAN-80 target instance provisioned on this remote (#16328;
# docs/incus-tcp-udp-plan.md) — not the loss xpf-mouse-target.
MOUSE_TARGET_NAME="xpf-udp-target"
MOUSE_TARGET_V4="${MOUSE_TARGET_V4:-172.16.80.211}"
MOUSE_TARGET_V6="${MOUSE_TARGET_V6:-2001:559:8585:80::211}"
