# TCP userspace cluster on remote tcp: (host 172.16.100.102). Plan: docs/incus-tcp-udp-plan.md
# Attempt 1 (2026-10-21): bridge fabric fallback (NET_FABRIC bridge) because
# SRIOV_FABRIC_PARENT machinery (plan section 4 item 6) is not yet implemented.
# WAN/LAN are SR-IOV VFs on mlx0/mlx1 per plan section 2.8.
# Subsequent code updates use deb deploy (config-preserving); first seed uses raw.

INCUS_REMOTE="tcp"
VM0="xpf-tcp-fw0"
VM1="xpf-tcp-fw1"
LAN_HOST="cluster-tcp-host"
PROFILE="xpf-cluster-tcp"

SRIOV_PARENT="mlx0"
SRIOV_LAN_PARENT="mlx1"
VF_LAN_VLAN=3668

NET_MGMT="incusbr-tcp"
NET_HEARTBEAT="bpu-tcp-hb0"
NET_FABRIC="bpu-tcp-fab0"
NET_CLAN=""

CLUSTER_CONF="docs/ha-cluster-tcp.conf"
# #16471/#8280: pool-mode source-NAT lever for test-failover.sh. Must agree
# with docs/ha-cluster-tcp.conf's `rule pool-snat` (source 10.0.62.240/28,
# pool/proxy-ARP address 172.16.80.12); test-failover derives both from
# CLUSTER_CONF and VOIDs the pool phase instead of reporting a false
# pool/proxy-ARP defect when they disagree.
POOL_SRC="10.0.62.240"
POOL_NAT_ADDR="172.16.80.12"

LAN_ADDR="10.0.62.102/24"
LAN_GW="10.0.62.1"
LAN_HOST_IP="10.0.62.102"
LAN_VIP4="10.0.62.1"
LAN_VIP6="2001:559:8585:aa00::1"
WAN_GW4="172.16.50.1"
# #18558: 172.16.50.10 is held by a non-xpf device on the shared VLAN 50
# (duplicate address); moved to 172.16.50.42. See CLUSTER_CONF.
WAN_VIP4="172.16.50.42"
# Firewall reth gateways per VLAN (#16305): reth0.50/.80 addresses from
# docs/ha-cluster-tcp.conf; wire gates use each on its own subnet.
DMZ_GW4="172.16.50.42"
WAN_GW80_4="172.16.80.10"
IPERF_TARGET4="172.16.80.210"
IPERF_TARGET6="2001:559:8585:80::210"
# VLAN-80 target instance provisioned on this remote (#16328;
# docs/incus-tcp-udp-plan.md) — not the loss xpf-mouse-target.
MOUSE_TARGET_NAME="xpf-tcp-target"
MOUSE_TARGET_V4="${MOUSE_TARGET_V4:-172.16.80.210}"
MOUSE_TARGET_V6="${MOUSE_TARGET_V6:-2001:559:8585:80::210}"
