# Canonical Makefile cluster/test target for userspace dataplane validation.
# Source via: BPFRX_CLUSTER_ENV=test/incus/loss-userspace-cluster.env ./test/incus/cluster-setup.sh <cmd>

INCUS_REMOTE="loss"
VM0="xpf-userspace-fw0"
VM1="xpf-userspace-fw1"
LAN_HOST="cluster-userspace-host"
PROFILE="xpf-cluster-userspace"

# Isolated userspace cluster on loss:
# - WAN uses a distinct spare mlx0 VF pair
# - LAN uses a distinct VLAN from the primary loss cluster
VF_WAN_PCI=("0000:65:00.4" "0000:65:00.5")
VF_LAN_PCI=("0000:65:05.4" "0000:65:05.5")
SRIOV_PARENT="mlx0"
SRIOV_LAN_PARENT="mlx1"
VF_LAN_VLAN=3667

NET_MGMT="incusbr0"
NET_HEARTBEAT="bpu-hb0"
NET_FABRIC="bpu-fab0"
NET_CLAN=""

CLUSTER_CONF="docs/ha-cluster-userspace.conf"
# #16471/#8280: pool-mode source-NAT lever for test-failover.sh, stated
# explicitly (these were previously only test-failover.sh's hardcoded
# defaults). Must agree with docs/ha-cluster-userspace.conf's
# `rule pool-snat` (source 10.0.61.240/28, pool/proxy-ARP 172.16.80.7);
# test-failover derives both from CLUSTER_CONF and VOIDs on disagreement.
POOL_SRC="10.0.61.240"
POOL_NAT_ADDR="172.16.80.7"

LAN_ADDR="10.0.61.102/24"
LAN_GW="10.0.61.1"
LAN_HOST_IP="10.0.61.102"
LAN_VIP4="10.0.61.1"
LAN_VIP6="2001:559:8585:ef00::1"
WAN_GW4="172.16.50.1"
WAN_VIP4="172.16.50.8"
# Firewall reth gateways per VLAN (#16305): reth0.50/.80 addresses from
# docs/ha-cluster-userspace.conf (.8 on both); WAN_VIP4 above is that same
# reth0.50 address (.8), as the tcp/udp envs pin theirs (.42/.43, #18558). Wire
# gates use each gateway on its own subnet.
DMZ_GW4="172.16.50.8"
WAN_GW80_4="172.16.80.8"
# iperf3 server lives on the WAN-side host attached to reth0.80 (VLAN 80,
# `172.16.80.0/24` / `2001:559:8585:80::/64`). Earlier versions of this env
# inherited `172.16.100.x` from the legacy `bpfrx-fw0/1` cluster and pointed
# smoke / failover scripts at an iperf3 listener reachable only via a
# different `loss:` uplink path that itself caps at ~9-10 Gb/s, which
# masqueraded as an xpf-side perf ceiling in #1578 / #1580 / #1593. The
# canonical AF_XDP fast path through `ge-0-0-2.80` delivers 22-23 Gb/s
# reverse P=12; the smoke target must point at the matching VLAN-80 host.
#
# #18576: the v4 target is .202, a static address that only xpf-mouse-target
# holds. mouse-target-setup.sh pins it in mouse-addr.service as
# TARGET_ALIAS_V4, which cluster-env.sh derives from this line. It was .200
# until 2026-10-31. The external v6 box (f6:f0:06:10:77:d5) also answers ARP
# for v4 .200, so the firewall's neighbor entry chose the server. In a loss
# rg-move soak that day, fw1 resolved .200 to that box, and all 8 v4 iperf
# streams died. Do not use these instead:
# - .201 (MOUSE_TARGET_V4): the separate mouse address (#8259); mice and
#   elephants must keep distinct addresses;
# - .174: the container's DHCPv4 lease from the lab server 172.16.80.2,
#   which nothing in the tree pins. A recreate (new MAC, so a new client
#   id) or a lapsed lease can hand it to another host.
# test-connectivity's iperf target cell must PASS here: exactly one holder,
# the container.
# OPEN PREMISE: .202 being outside 172.16.80.2's DHCP pool is NOT shown. The
# pool range cannot be read from here: a DISCOVER returns one offer, and the
# server is lab hardware. Observed leases are .130 (the udp target) and .174
# (this container), and observed holders reach .243-.245. The per-run claim
# cell bounds the risk: a later lease of .202 to another host is a FAIL in
# that run, not a silent wrong-host measurement.
IPERF_TARGET4="172.16.80.202"
# DEPRECATED alias: .200 stays pinned on the container beside .202, so a
# container restart does not strand the consumers that still name it (older
# checkouts, and the hard-coded harnesses listed in docs/log/18576.md).
# That is no worse than before, because .200 is dual-held either way.
# mouse-target-setup.sh keeps this pin only while the container ALREADY
# holds the address, and never claims it anew. Nothing may measure .200.
# On expiry: delete this line, then run `ip addr del 172.16.80.200/24 dev eth0`
# on the container, once the hard-coded follow-up harnesses are retargeted
# and no open branch predates #18619 (#18576).
# Expires-when: #18576 closed
TARGET_ALIAS_V4_DEPRECATED="172.16.80.200"
IPERF_TARGET6="2001:559:8585:80::200"
# The VLAN-50 DMZ prober (xpf-zone-matrix-dmz) stays at .201/::201.
# cluster-env.sh would otherwise derive it from the iperf target's octet
# plus 1, which is .203 since #18576. Pinned here, and caller overrides win.
DMZ_ADDR="${DMZ_ADDR:-172.16.50.201}"
DMZ_TARGET_V6="${DMZ_TARGET_V6:-2001:559:8585:50::201}"
# #18586: loss's v4 and v6 iperf targets are DIFFERENT hosts by lab design.
# v4 .202 is xpf-mouse-target. v6 ::200 DAD-failed there and lives on the
# external box (#16213, #18576). So test-connectivity's Group12 neighbor
# identity judges each family's RG-owner entry alone instead of requiring
# one MAC. tcp and udp use one container for both, and default to "yes".
# The #18576 v4 retarget leaves this split in place, because v6 still
# measures the external box.
IPERF_TARGET_V4_V6_SAME_HOST="no"
# The split's same-run control: the RG owner's v6 entry must name this host
# (the external box), and its v4 entry must name a different MAC. On expiry:
# delete both lines (and the matrix's "different hosts" environment row).
# Expires-when: loss's v4 and v6 iperf targets are one host; Review-by: 2026-11-30
IPERF_TARGET6_SPLIT_HOLDER="f6:f0:06:10:77:d5"

# #8259: the SECOND VLAN-80 target, so a mouse-latency verdict can be
# attributed.
#
# Mice and elephants both terminated on IPERF_TARGET4 above, which meant the
# loaded cell added the elephants' ~8.6 Gbit/s of receive load to the very host
# whose service time is inside every mouse sample. The loaded/idle ratio could
# not separate firewall queueing from target-host service, so #8467 made the
# gate return VOID-NOT-ATTRIBUTABLE rather than a PASS or FAIL it could not
# support — and recorded that the check "passes the moment the two targets
# differ".
#
# It could not be made to differ: the standing target is external lab hardware
# with no management path (see target-services.sh), and the firewall's WAN
# neighbour table held exactly two entries. `test/incus/mouse-target-setup.sh`
# creates a third — an incus container with an SR-IOV VF tagged into VLAN 80,
# running the same service grid — so there is somewhere to move the mice to.
#
# Set as a DEFAULT rather than wired into the harnesses: a run that wants both
# flows on one host (reproducing an older measurement, say) overrides it, and
# every existing harness that never mentions MOUSE_TARGET_V4 keeps its previous
# behaviour except that the gate can now attribute the result.
MOUSE_TARGET_V4="${MOUSE_TARGET_V4:-172.16.80.201}"
MOUSE_TARGET_V6="${MOUSE_TARGET_V6:-2001:559:8585:80::201}"
