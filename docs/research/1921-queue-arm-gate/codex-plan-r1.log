    97	/// socket-local fill/completion rings but still depend on the live shared UMEM
    98	/// pointer passed through `worker_umem`.
    99	pub(super) unsafe fn open_binding_worker_rings(
   100	    worker_umem: &mut WorkerUmem,
   101	    info: &IfInfo,
   102	    ring_entries: u32,
   103	    bind_strategy: AfXdpBindStrategy,
   104	    socket_role: XskSocketRole,
   105	    driver_name: Option<&str>,
   106	    poll_mode: crate::PollMode,
   107	    pre_bind_fill_offsets: Option<&[u64]>,
   108	) -> Result<
   109	    (
   110	        User,
   111	        RingRx,
   112	        RingTx,
   113	        XskBindMode,
   114	        u16,
   115	        AfXdpBindStrategy,
   116	        DeviceQueue,
   117	    ),
   118	    Box<dyn std::error::Error + Send + Sync>,
   119	> {
   120	    let bind_flag_candidates = bind_flag_candidates_for_socket_role(info, driver_name, socket_role);
   121	    let mut strategies = vec![bind_strategy];
   122	    if let Some(fallback_strategy) = alternate_bind_strategy(driver_name, bind_strategy) {
   123	        strategies.push(fallback_strategy);
   124	    }
   125	    let mut last_err: Option<Box<dyn std::error::Error + Send + Sync>> = None;
   126	    for (strategy_idx, strategy) in strategies.iter().copied().enumerate() {
   127	        for (flags_idx, flags) in bind_flag_candidates.iter().copied().enumerate() {
   128	            match try_open_bind(
   129	                worker_umem,
   130	                info,
   131	                ring_entries,
   132	                flags,
   133	                socket_role,
   134	                poll_mode,
   135	                pre_bind_fill_offsets,
   136	            ) {
   137	                Ok((user, rx, tx, bind_mode, actual_flags, device)) => {
   138	                    return Ok((user, rx, tx, bind_mode, actual_flags, strategy, device));
   139	                }
   140	                Err(err) => {
   141	                    last_err = Some(err);
   142	                    let more_flag_attempts = flags_idx + 1 < bind_flag_candidates.len();
   143	                    let more_strategy_attempts = strategy_idx + 1 < strategies.len();
   144	                    if more_flag_attempts {
   145	                        eprintln!(
   146	                            "xpf-userspace-dp: {} bind failed using {}: {} — trying {}",
   147	                            describe_bind_flags(flags),
   148	                            strategy.describe(),
   149	                            last_err.as_ref().unwrap(),
   150	                            describe_bind_flags(bind_flag_candidates[flags_idx + 1]),
   151	                        );
   152	                    } else if more_strategy_attempts {
   153	                        eprintln!(
   154	                            "xpf-userspace-dp: {} bind failed using {} on driver {:?}: {} — retrying {}",
   155	                            describe_bind_flags(flags),
   156	                            strategy.describe(),
   157	                            driver_name,
   158	                            last_err.as_ref().unwrap(),
   159	                            strategies[strategy_idx + 1].describe(),
   160	                        );
   161	                    }
   162	                }
   163	            }
   164	        }
   165	    }
   166	    Err(last_err.unwrap_or_else(|| "AF_XDP bind: no attempts executed".into()))
   167	}
