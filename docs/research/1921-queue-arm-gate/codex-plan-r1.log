  1250	func (m *Manager) hasBusyBindingsWedgeLocked(repaired bool) bool {
  1251		if m.proc == nil || m.proc.Process == nil {
  1252			return false
  1253		}
  1254		if !m.lastStatus.ForwardingArmed || m.deferWorkers {
  1255			return false
  1256		}
  1257		if m.xskLivenessProven || m.xskLivenessFailed {
  1258			return false
  1259		}
  1260		bindings := m.lastStatus.Bindings
  1261		if len(bindings) == 0 {
  1262			return false
  1263		}
  1264		registeredArmed := 0
  1265		bound := 0
  1266		ready := 0
  1267		busyErr := false
  1268		for _, binding := range bindings {
  1269			if binding.Ifindex <= 0 {
  1270				continue
  1271			}
  1272			if binding.Registered && binding.Armed {
  1273				registeredArmed++
  1274			}
  1275			if binding.Bound {
  1276				bound++
  1277			}
  1278			if binding.Ready {
  1279				ready++
  1280			}
  1281			if strings.Contains(strings.ToLower(binding.LastError), "resource busy") {
  1282				busyErr = true
  1283			}
  1284		}
  1285		return registeredArmed > 0 && bound == 0 && ready == 0 && (busyErr || repaired)
  1286	}
