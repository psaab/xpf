   170	                            "interface {} ineligible for same-device-debug shared UMEM: driver={} device_path={}",
   171	                            plan.status.interface, info.driver, info.device_path
   172	                        ),
   173	                    );
   174	                }
   175	                Err(err) => {
   176	                    plans[idx].shared_umem =
   177	                        SharedUmemBindingPlan::disabled(SharedUmemMode::SameDeviceDebug, err);
   178	                }
   179	            }
   180	        }
   181	        for (device, indexes) in by_device {
   182	            if indexes.len() < 2 {
   183	                for idx in indexes {
