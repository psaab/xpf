   203	        let plan = &plans[*idx];
   204	        (plan.status.queue_id, plan.status.ifindex, plan.status.slot)
   205	    });
   206	    for (pos, idx) in indexes.into_iter().enumerate() {
   207	        let role = if pos == 0 {
   208	            SharedUmemSocketRole::Owner
   209	        } else {
   210	            SharedUmemSocketRole::Secondary
   211	        };
   212	        plans[idx].shared_umem = SharedUmemBindingPlan::shared(mode, key.clone(), role);
   213	    }
   214	}
