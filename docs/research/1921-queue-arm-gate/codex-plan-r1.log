   746	pub(crate) fn replan_bindings_from_candidates(
   747	    workers: usize,
   748	    existing: &[BindingStatus],
   749	    candidates: Vec<(String, usize)>,
   750	    ifindex_by_name: BTreeMap<String, i32>,
   751	) -> Vec<BindingStatus> {
   752	    let mut existing_by_slot = BTreeMap::new();
   753	    for binding in existing {
   754	        existing_by_slot.insert(binding.slot, binding.clone());
   755	    }
   756	    if candidates.is_empty() {
   757	        return Vec::new();
   758	    }
   759	    let queue_count = candidates.iter().map(|(_, rx)| *rx).min().unwrap_or(0);
   760	    let interfaces = candidates
   761	        .iter()
   762	        .map(|(name, _)| name.clone())
   763	        .collect::<Vec<_>>();
   764	    let mut out = Vec::with_capacity(queue_count * interfaces.len());
   765	    let mut slot = 0u32;
   766	    for queue_id in 0..queue_count {
   767	        for iface in &interfaces {
   768	            let mut binding = existing_by_slot.remove(&slot).unwrap_or_default();
   769	            let had_existing = binding.last_change.is_some()
   770	                || binding.registered
   771	                || binding.armed
   772	                || binding.ready
   773	                || binding.bound
   774	                || binding.xsk_registered;
   775	            binding.slot = slot;
   776	            binding.queue_id = queue_id as u32;
   777	            binding.worker_id = (queue_id % workers.max(1)) as u32;
   778	            binding.interface = iface.clone();
   779	            binding.ifindex = *ifindex_by_name.get(iface).unwrap_or(&0);
   780	            if binding.ifindex <= 0 {
   781	                binding.registered = false;
   782	                binding.armed = false;
   783	                binding.ready = false;
   784	            } else if !had_existing {
   785	                binding.registered = true;
   786	            }
   787	            if binding.last_change.is_none() {
   788	                binding.last_change = Some(Utc::now());
   789	            }
   790	            out.push(binding);
   791	            slot += 1;
   792	        }
   793	    }
   794	    out
   795	}
