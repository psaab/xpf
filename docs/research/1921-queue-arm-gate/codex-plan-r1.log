   197	fn assign_group_roles<I>(plans: &mut [BindingPlan], indexes: I, mode: SharedUmemMode, key: String)
   198	where
   199	    I: IntoIterator<Item = usize>,
   200	{
   201	    let mut indexes = indexes.into_iter().collect::<Vec<_>>();
