   352	/// Create and bind an XSK socket using libxdp's `xsk_socket__create_shared`.
   353	///
   354	/// This replaces the multi-step xdpilone flow (Socket::with_shared →
   355	/// umem.fq_cq → umem.rx_tx → user.map_rx/map_tx → umem.bind) with a
   356	/// single libxdp call that does UMEM registration, ring setup, and bind
   357	/// atomically — matching the proven libbpf xsk code path.
   358	fn try_open_bind(
   359	    worker_umem: &mut WorkerUmem,
   360	    info: &IfInfo,
   361	    ring_entries: u32,
   362	    bind_flags: u16,
   363	    socket_role: XskSocketRole,
   364	    poll_mode: crate::PollMode,
   365	    pre_bind_fill_offsets: Option<&[u64]>,
   366	) -> Result<
   367	    (User, RingRx, RingTx, XskBindMode, u16, DeviceQueue),
   368	    Box<dyn std::error::Error + Send + Sync>,
   369	> {
   370	    for attempt in 0..BIND_RETRY_ATTEMPTS {
   371	        let create_result = match socket_role.create_mode() {
   372	            xsk_ffi::XskCreateMode::PrivateUmem => unsafe {
   373	                xsk_ffi::create_xsk_binding_private(
   374	                    worker_umem.umem_mut(),
   375	                    info,
   376	                    ring_entries,
   377	                    bind_flags,
   378	                )
   379	            },
   380	            xsk_ffi::XskCreateMode::SharedUmem => unsafe {
   381	                xsk_ffi::create_xsk_binding_shared(
   382	                    worker_umem.as_raw_umem_ptr(),
   383	                    info,
   384	                    ring_entries,
   385	                    bind_flags,
   386	                )
   387	            },
   388	        };
   389	        match create_result {
   390	            Ok((user, rx, tx, mut device)) => {
   391	                let user_fd = user.as_raw_fd();
   392	
   393	                // Prime the fill ring AFTER bind — libxdp already binds
   394	                // the socket during create_shared. Post-bind fill ring
   395	                // priming triggers NAPI to consume entries and post WQEs.
   396	                if let Some(offsets) = pre_bind_fill_offsets {
   397	                    prime_fill_ring_offsets(&mut device, offsets)?;
   398	                }
   399	
   400	                let bind_mode = query_bound_xsk_mode(user_fd).unwrap_or(XskBindMode::Copy);
   401	                if socket_role.requires_zerocopy() && !bind_mode.is_zerocopy() {
   402	                    return Err(format!(
   403	                        "{} bind(fd={}) did not report XDP_OPTIONS_ZEROCOPY after bind",
   404	                        socket_role.describe(),
   405	                        user_fd
   406	                    )
   407	                    .into());
   408	                }
   409	                set_busy_poll_opts(user_fd, poll_mode);
   410	                eprintln!(
   411	                    "xpf-userspace-dp: libxdp bind(fd={}) OK on attempt {} role={} mode={:?} flags=0x{:04x}",
   412	                    user_fd,
   413	                    attempt,
   414	                    socket_role.describe(),
   415	                    bind_mode,
   416	                    bind_flags,
   417	                );
   418	
   419	                return Ok((user, rx, tx, bind_mode, bind_flags, device));
   420	            }
   421	            Err(err) => {
   422	                let msg = err.to_string();
   423	                if attempt + 1 < BIND_RETRY_ATTEMPTS && msg.contains("Device or resource busy") {
   424	                    thread::sleep(BIND_RETRY_DELAY);
   425	                    continue;
   426	                }
   427	                return Err(format!(
   428	                    "libxdp {} bind(flags=0x{:04x}): {msg}",
   429	                    socket_role.describe(),
   430	                    bind_flags,
   431	                )
   432	                .into());
   433	            }
   434	        }
   435	    }
   436	    Err(format!(
   437	        "libxdp bind: exhausted {} retries with flags=0x{:04x}",
   438	        BIND_RETRY_ATTEMPTS, bind_flags,
   439	    )
   440	    .into())

