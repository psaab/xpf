   797	pub(crate) fn summarize_queues(bindings: &[BindingStatus]) -> Vec<QueueStatus> {
   798	    let mut by_queue: BTreeMap<u32, Vec<&BindingStatus>> = BTreeMap::new();
   799	    for binding in bindings {
   800	        by_queue.entry(binding.queue_id).or_default().push(binding);
   801	    }
   802	    let mut out = Vec::with_capacity(by_queue.len());
   803	    for (queue_id, group) in by_queue {
   804	        let worker_id = group.first().map(|b| b.worker_id).unwrap_or(0);
   805	        let interfaces = group
   806	            .iter()
   807	            .map(|b| b.interface.clone())
   808	            .collect::<Vec<_>>();
   809	        let registered = !group.is_empty() && group.iter().all(|b| b.registered);
   810	        let armed = !group.is_empty() && group.iter().all(|b| b.registered && b.armed);
   811	        let ready = !group.is_empty() && group.iter().all(|b| b.registered && b.ready);
   812	        let last_change = group.iter().filter_map(|b| b.last_change).max();
   813	        out.push(QueueStatus {
   814	            queue_id,
   815	            worker_id,
   816	            interfaces,
   817	            registered,
   818	            armed,
   819	            ready,
   820	            last_change,
   821	        });
   822	    }
   823	    out
   824	}
