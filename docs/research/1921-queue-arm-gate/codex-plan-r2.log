 fn afxdp_runtime_starts_only_when_armed_and_supported() {
     let status = ProcessStatus {
         forwarding_armed: true,
         capabilities: UserspaceCapabilities {
             forwarding_supported: true,
             unsupported_reasons: Vec::new(),
         },
         ..Default::default()
     };
